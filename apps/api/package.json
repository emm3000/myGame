{
  "name": "@mygame/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/listen.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:hono --external:pg --external:drizzle-orm --external:@node-rs/argon2 --external:nodemailer --external:@hono/zod-openapi --external:zod --external:@vercel/functions",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "openapi:write": "tsx src/writeOpenApiDocument.ts && biome format --write openapi.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@mygame/catalog": "workspace:*",
    "@mygame/contracts": "workspace:*",
    "@mygame/domain": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@vercel/functions": "3.10.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "nodemailer": "10.0.11",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@hono/node-server": "2.1.1",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
