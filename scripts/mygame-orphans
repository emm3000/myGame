#!/usr/bin/env bash
set -euo pipefail

keep_emulator=0
case $* in
  '') ;;
  --keep-emulator) keep_emulator=1 ;;
  *) echo "usage: scripts/mygame-orphans [--keep-emulator]" >&2; exit 64 ;;
esac

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
found=0
kept_refs=""
live_peers=""

report() {
  echo "orphan: $1"
  found=1
}

contains() {
  awk -v item="$2" '$0 == item { found = 1 } END { exit !found }' <<<"$1"
}

cwds=$(lsof -d cwd -Fpcn +c 0 2>/dev/null | awk '
  /^p/ { pid = substr($0, 2) }
  /^c/ { name = substr($0, 2) }
  /^n/ { print pid "\t" name "\t" substr($0, 2) }' || true)

running=$(ps -axo pid=,command= | awk '
  {
    command = $2
    sub(/.*\//, "", command)
    if (command != "claude") next
    for (i = 3; i < NF; i++) if ($i == "-n") { print $1 "\t" $(i + 1); next }
  }')

is_live() {
  awk -F '\t' -v name="$1" -v path="$2" '
    FNR == NR { if ($2 == name) pids[$1] = 1; next }
    ($1 in pids) && ($3 == path || index($3, path "/") == 1) { found = 1 }
    END { exit !found }' <(printf '%s\n' "$running") <(printf '%s\n' "$cwds")
}

owned_by_a_live_session() {
  local owner=${1#mygame-}
  [[ $owner == orch-* ]] || contains "$live_peers" "${owner%-*}"
}

main_worktree=""
while IFS="$(printf '\t')" read -r path branch; do
  [ -n "$path" ] || continue
  if [ -z "$main_worktree" ]; then
    main_worktree=$path
    continue
  fi
  folder=$(basename "$path")
  name=${folder#mygame-}
  if [ "$name" != "$folder" ] && [ -d "$path" ] && is_live "$name" "$path"; then
    live_peers="$live_peers$name"$'\n'
    if [ -n "$branch" ]; then
      ticket=${branch#*/}
      ticket=${ticket%%-*}
      kept_refs="$kept_refs$branch"$'\n'"assets/$ticket-visual-check"$'\n'
    fi
  else
    report "worktree $path"
  fi
done < <(git -C "$repo" worktree list --porcelain | awk '
  /^worktree / { if (path != "") print path "\t" branch; path = substr($0, 10); branch = "" }
  /^branch refs\/heads\// { branch = substr($0, 19) }
  END { if (path != "") print path "\t" branch }')

while read -r ref; do
  branch=${ref#refs/heads/}
  [ -z "$branch" ] || [ "$branch" = trunk ] || contains "$kept_refs" "$branch" || report "branch $branch"
done < <(git -C "$repo" for-each-ref --format='%(refname)' refs/heads)

git -C "$repo" fetch -q --prune origin 2>/dev/null || echo "orphans: git fetch failed, remote refs may be stale" >&2
while read -r ref; do
  case $ref in
    '' | refs/remotes/origin/trunk | refs/remotes/origin/HEAD) continue ;;
    refs/remotes/origin/*) ! contains "$kept_refs" "${ref#refs/remotes/origin/}" || continue ;;
  esac
  report "remote ref $ref"
done < <(git -C "$repo" for-each-ref --format='%(refname)' refs/remotes)

if command -v docker >/dev/null; then
  if containers=$(docker ps -a --format '{{.Names}}' 2>/dev/null); then
    while read -r container; do
      [[ $container == mygame-* ]] || continue
      owned_by_a_live_session "$container" || report "container $container"
    done <<<"$containers"
    while IFS="$(printf '\t')" read -r volume labels; do
      [ -n "$volume" ] || continue
      if [[ $volume == mygame-* ]]; then
        owned_by_a_live_session "$volume" || report "dangling volume $volume"
      elif [[ $labels == *mygame* ]]; then
        report "dangling volume $volume"
      fi
    done <<<"$(docker volume ls -f dangling=true --format '{{.Name}}\t{{.Labels}}' 2>/dev/null || true)"
  else
    echo "orphans: docker unreachable, containers and volumes not checked" >&2
  fi
fi

while IFS="$(printf '\t')" read -r pid name path; do
  case $path in
    */mygame-*) ;;
    *) continue ;;
  esac
  [ ! -d "$path" ] || continue
  if [[ $name =~ ^(emulator|qemu|crashpad|netsim) ]]; then
    if [ "$keep_emulator" -eq 1 ]; then
      echo "kept: emulator $pid in $path"
    else
      report "emulator $pid in missing $path"
    fi
  else
    report "process $pid in missing $path"
  fi
done <<<"$cwds"

[ "$found" -eq 1 ] || echo "orphans: none"
exit "$found"
