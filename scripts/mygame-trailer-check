#!/usr/bin/env bash
set -euo pipefail

input=$(</dev/stdin)
shopt -s nocasematch
[[ $input == *git*commit* && $input == *co-authored-by* ]] || exit 0

status=0
printf '%s' "$input" | jq -e '.tool_input.command | (test("git +commit") and test("co-authored-by"; "i")) | not' >/dev/null || status=$?
case $status in
  0) exit 0 ;;
  1)
    echo 'Blocked: Co-Authored-By trailers are forbidden in this repo (CLAUDE.md)' >&2
    exit 2
    ;;
esac
echo "Blocked: scripts/mygame-trailer-check failed with exit $status" >&2
exit 2
