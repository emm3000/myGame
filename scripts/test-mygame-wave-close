#!/usr/bin/env bash
set -euo pipefail

scripts_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

while IFS= read -r variable; do
  unset "$variable"
done < <(compgen -e | awk '/^GIT_/')
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.invalid
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.invalid

temp_base=${TMPDIR:-/tmp}
sandbox=$(mktemp -d "${temp_base%/}/wave-close-test.XXXXXX") || { echo "refusing the sandbox: mktemp -d failed" >&2; exit 70; }
[ -n "$sandbox" ] && [ -d "$sandbox" ] || { echo "refusing the sandbox: mktemp -d printed no directory" >&2; exit 70; }
sandbox=$(cd "$sandbox" && pwd -P)
case $sandbox in
  "$(cd "$temp_base" && pwd -P)"/?*) ;;
  *) echo "refusing the sandbox: $sandbox is not under $temp_base" >&2; exit 70 ;;
esac
trap 'rm -rf "$sandbox"' EXIT
export GIT_CEILING_DIRECTORIES="$sandbox"

claude_pid=900000001
node_pid=900000002
qemu_pid=900000003
neighbor_pid=900000004
live_pid=900000005
stranger_pid=900000006
picantea_emulator_pid=900000007
medium_phone_emulator_pid=900000008
live_emulator_pid=900000009
probe_emulator_pid=900000010
probe2_emulator_pid=900000011
serial_only_emulator_pid=900000012
failures=0
case_dir=""
repo=""

mkdir -p "$sandbox/bin"
write_stub() {
  {
    echo '#!/usr/bin/env bash'
    awk 1
  } >"$sandbox/bin/$1"
  chmod +x "$sandbox/bin/$1"
}
write_stub ps <<'STUB'
awk -F '\t' '{ print $1 " " $4 }' "$FAKE_STATE/processes"
STUB
write_stub lsof <<'STUB'
awk -F '\t' '{ print "p" $1; print "c" $2; print "fcwd"; print "n" $3 }' "$FAKE_STATE/processes"
STUB
write_stub kill <<'STUB'
for pid in "$@"; do
  case $pid in -*) continue ;; esac
  awk -F '\t' -v pid="$pid" '$1 == pid { found = 1 } END { exit !found }' "$FAKE_STATE/processes" || { echo "kill: ($pid) - No such process" >&2; exit 1; }
  echo "$pid" >>"$FAKE_STATE/killed"
  awk -F '\t' -v pid="$pid" '$1 != pid' "$FAKE_STATE/processes" >"$FAKE_STATE/processes.next"
  mv "$FAKE_STATE/processes.next" "$FAKE_STATE/processes"
  awk -F '\t' -v pid="$pid" '$3 != pid' "$FAKE_STATE/devices" >"$FAKE_STATE/devices.next"
  mv "$FAKE_STATE/devices.next" "$FAKE_STATE/devices"
done
STUB
write_stub adb <<'STUB'
if [ "$1" = devices ]; then
  echo "List of devices attached"
  awk -F '\t' '{ print $1 "\tdevice" }' "$FAKE_STATE/devices"
  exit 0
fi
[ "$1" = -s ] || { echo "unexpected adb $*" >&2; exit 1; }
serial=$2
shift 2
device=$(awk -F '\t' -v serial="$serial" '$1 == serial' "$FAKE_STATE/devices")
[ -n "$device" ] || { echo "adb: device '$serial' not found" >&2; exit 1; }
case "$*" in
  "emu avd name") printf '%s\r\nOK\r\n' "$(cut -f 2 <<<"$device")" ;;
  "emu kill")
    pid=$(cut -f 3 <<<"$device")
    echo "$serial" >>"$FAKE_STATE/killed"
    awk -F '\t' -v serial="$serial" '$1 != serial' "$FAKE_STATE/devices" >"$FAKE_STATE/devices.next"
    mv "$FAKE_STATE/devices.next" "$FAKE_STATE/devices"
    awk -F '\t' -v pid="$pid" '$1 != pid' "$FAKE_STATE/processes" >"$FAKE_STATE/processes.next"
    mv "$FAKE_STATE/processes.next" "$FAKE_STATE/processes"
    echo "OK" ;;
  *) echo "unexpected adb -s $serial $*" >&2; exit 1 ;;
esac
STUB
mkdir -p "$sandbox/android/cmdline-tools/latest/bin"
avdmanager_stub="$sandbox/android/cmdline-tools/latest/bin/avdmanager"
{
  echo '#!/usr/bin/env bash'
  awk 1
} >"$avdmanager_stub" <<'STUB'
case $ANDROID_AVD_HOME in
  "$SANDBOX"/?*) ;;
  *) echo "refusing avdmanager: ANDROID_AVD_HOME $ANDROID_AVD_HOME is outside the sandbox" >&2; exit 70 ;;
esac
[ "$#" -eq 4 ] && [ "$1 $2 $3" = "delete avd -n" ] || { echo "unexpected avdmanager $*" >&2; exit 1; }
[ -d "$ANDROID_AVD_HOME/$4.avd" ] || { echo "Error: There is no Android Virtual Device named '$4'." >&2; exit 1; }
rm -rf "${ANDROID_AVD_HOME:?}/$4.avd" "${ANDROID_AVD_HOME:?}/$4.ini"
echo "$4" >>"$FAKE_STATE/deleted"
echo "AVD '$4' deleted."
STUB
chmod +x "$avdmanager_stub"
write_stub docker <<'STUB'
case "$1 $2" in
  "ps -a") awk 1 "$FAKE_STATE/containers" ;;
  "volume ls")
    awk -F '\t' -v dangling="$([[ " $* " == *" dangling=true "* ]] && echo 1)" '
      FNR == NR { running[$0] = 1; next }
      !dangling || $3 == "" || !($3 in running) { print $1 "\t" $2 }' "$FAKE_STATE/containers" "$FAKE_STATE/volumes" ;;
  "volume inspect") awk -F '\t' -v name="$3" '$1 == name { found = 1 } END { exit !found }' "$FAKE_STATE/volumes" || { echo "Error response from daemon: get $3: no such volume" >&2; exit 1; } ;;
  "volume rm")
    awk -F '\t' -v name="$3" 'FNR == NR { if ($1 == name) { found = 1; holder = $3 }; next } holder != "" && $0 == holder { busy = 1 } END { exit !(found && !busy) }' "$FAKE_STATE/volumes" "$FAKE_STATE/containers" || { echo "Error response from daemon: remove $3: volume is missing or in use" >&2; exit 1; }
    awk -F '\t' -v name="$3" '$1 != name' "$FAKE_STATE/volumes" >"$FAKE_STATE/volumes.next"
    mv "$FAKE_STATE/volumes.next" "$FAKE_STATE/volumes"
    echo "$3" ;;
  "rm -fv")
    shift 2
    for container in "$@"; do
      awk -v name="$container" '$0 == name { found = 1 } END { exit !found }' "$FAKE_STATE/containers" || { echo "Error response from daemon: No such container: $container" >&2; exit 1; }
      awk -v name="$container" '$0 != name' "$FAKE_STATE/containers" >"$FAKE_STATE/containers.next"
      mv "$FAKE_STATE/containers.next" "$FAKE_STATE/containers"
      echo "$container"
    done ;;
  *) echo "unexpected docker $*" >&2; exit 1 ;;
esac
STUB
write_stub gh <<'STUB'
echo "unexpected gh $*" >&2
exit 1
STUB

build_a_live_peer() {
  case_dir="$sandbox/$1"
  repo="$case_dir/myGame"
  mkdir -p "$repo/scripts" "$case_dir/state" "$case_dir/mygame-probex" "$case_dir/pichanga-probe"
  cp "$scripts_dir/mygame-wave-close" "$scripts_dir/mygame-orphans" "$repo/scripts/"
  git init -q --bare -b trunk "$case_dir/origin.git"
  git -C "$repo" init -q -b trunk
  git -C "$repo" commit -q --allow-empty -m "chore: start"
  git -C "$repo" remote add origin "$case_dir/origin.git"
  git -C "$repo" worktree add -q -b chore/9-live "$case_dir/mygame-live" trunk
  git -C "$repo" push -q -u origin trunk chore/9-live
  git -C "$repo" remote set-head origin trunk >/dev/null
  {
    printf '%s\tclaude\t%s\tclaude -n probex --model opus\n' "$neighbor_pid" "$case_dir/mygame-probex"
    printf '%s\tclaude\t%s\tclaude -n probe --model opus\n' "$stranger_pid" "$case_dir/pichanga-probe"
    printf '%s\tclaude\t%s\tclaude -n live --model opus\n' "$live_pid" "$case_dir/mygame-live"
  } >"$case_dir/state/processes"
  printf '%s\n' mygame-orch-pg mygame-live-pg >"$case_dir/state/containers"
  printf 'mygame-live-pgdata\t\tmygame-live-pg\n' >"$case_dir/state/volumes"
  : >"$case_dir/state/killed"
  : >"$case_dir/state/deleted"
  : >"$case_dir/state/devices"
  for avd in Medium_Phone_5560 hello-1 picantea-reembolso mygame-live; do
    add_an_avd "$avd"
  done
  add_an_emulator "$picantea_emulator_pid" picantea-x 5590 "$case_dir/pichanga-probe"
  add_an_emulator "$medium_phone_emulator_pid" Medium_Phone_5560 5560 "$case_dir"
  add_an_emulator "$live_emulator_pid" mygame-live 5562 "$case_dir/mygame-live"
}

add_an_avd() {
  mkdir -p "$case_dir/avd/$1.avd"
  printf 'path=%s\n' "$case_dir/avd/$1.avd" >"$case_dir/avd/$1.ini"
}

add_an_emulator() {
  printf '%s\tqemu-system-aarch64-headless\t%s\tqemu-system-aarch64-headless -avd %s -port %s -no-window -no-audio -gpu host\n' \
    "$1" "$4" "$2" "$3" >>"$case_dir/state/processes"
  printf 'emulator-%s\t%s\t%s\n' "$3" "$2" "$1" >>"$case_dir/state/devices"
}

build_a_merged_ticket_beside_a_live_peer() {
  build_a_live_peer "$1"
  git -C "$repo" worktree add -q -b chore/7-probe "$case_dir/mygame-probe" trunk
  git -C "$repo" branch assets/7-visual-check
  git -C "$repo" push -q origin chore/7-probe assets/7-visual-check
  mkdir -p "$case_dir/mygame-probe/apps/api"
  {
    printf '%s\tclaude\t%s\tclaude -n probe --model opus\n' "$claude_pid" "$case_dir/mygame-probe"
    printf '%s\tnode\t%s\tnode tsx watch src/main.ts\n' "$node_pid" "$case_dir/mygame-probe/apps/api"
    printf '%s\tqemu-system-aarch64\t%s\tqemu-system-aarch64 -netdev user\n' "$qemu_pid" "$case_dir/mygame-probe"
  } >>"$case_dir/state/processes"
  printf '%s\n' mygame-probe-pg mygame-probe-mail >>"$case_dir/state/containers"
  printf 'mygame-probe-pgdata\t\tmygame-probe-pg\n' >>"$case_dir/state/volumes"
}

build_a_peer_with_its_own_avd() {
  build_a_merged_ticket_beside_a_live_peer "$1"
  add_an_avd mygame-probe
  add_an_emulator "$probe_emulator_pid" mygame-probe 5564 "$case_dir/mygame-probe"
  mkdir -p "$case_dir/mygame-probe2"
  add_an_avd mygame-probe2
  add_an_emulator "$probe2_emulator_pid" mygame-probe2 5566 "$case_dir/mygame-probe2"
}

with_stubs() {
  (
    export FAKE_STATE="$case_dir/state" PATH="$sandbox/bin:$PATH" SANDBOX="$sandbox"
    export HOME="$case_dir/home" ANDROID_HOME="$sandbox/android" ANDROID_AVD_HOME="$case_dir/avd"
    for tool in adb docker gh kill lsof ps; do
      [ "$(type -P "$tool")" = "$sandbox/bin/$tool" ] || { echo "refusing to run: stub $tool is not first on PATH" >&2; exit 70; }
    done
    cd "$repo" && "$@" 2>&1
  )
}

killed() {
  sort "$case_dir/state/killed" | tr '\n' ' '
}

deleted() {
  sort "$case_dir/state/deleted" | tr '\n' ' '
}

avds() {
  (cd "$case_dir/avd" && printf '%s\n' *) | LC_ALL=C sort | tr '\n' ' '
}

decoys_survive() {
  local avd
  for avd in Medium_Phone_5560 hello-1 picantea-reembolso; do
    [ -d "$case_dir/avd/$avd.avd" ] && [ -f "$case_dir/avd/$avd.ini" ] || { echo "decoy avd $avd is gone"; return 1; }
  done
  awk -F '\t' -v a="$picantea_emulator_pid" -v b="$medium_phone_emulator_pid" '$1 == a || $1 == b { found++ } END { exit found != 2 }' \
    "$case_dir/state/processes" || { echo "a decoy emulator process is gone"; return 1; }
  awk -F '\t' '$1 == "emulator-5590" || $1 == "emulator-5560" { found++ } END { exit found != 2 }' \
    "$case_dir/state/devices" || { echo "a decoy emulator serial is gone"; return 1; }
  if awk -v a="$picantea_emulator_pid" -v b="$medium_phone_emulator_pid" '$0 == a || $0 == b || $0 == "emulator-5590" || $0 == "emulator-5560" { found = 1 } END { exit !found }' \
    "$case_dir/state/killed"; then
    echo "a decoy emulator was stopped"
    return 1
  fi
}

refs() {
  git -C "$repo" for-each-ref --format='%(refname)' "$1" | sort | tr '\n' ' '
}

fail() {
  printf 'FAIL %s:\n%s\n' "$1" "$2" >&2
  return 1
}

spares_the_emulator_under_keep_emulator_and_kills_node() {
  build_a_merged_ticket_beside_a_live_peer keep
  local output
  output=$(with_stubs scripts/mygame-wave-close probe --keep-emulator) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ "$(tail -n 2 <<<"$output")" = "kept: emulator $qemu_pid in $case_dir/mygame-probe"$'\n'"orphans: none" ] || fail "${FUNCNAME[0]}" "$output"
}

kills_the_emulator_without_keep_emulator() {
  build_a_merged_ticket_beside_a_live_peer plain
  local output
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid $qemu_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)"
}

closes_an_already_closed_session_quietly() {
  build_a_merged_ticket_beside_a_live_peer twice
  local first second
  first=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "first run failed: $first" || return 1
  second=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "second run failed: $second" || return 1
  case "$first$second" in
    *fatal:* | *error:* | *Error* | *"No such"*) fail "${FUNCNAME[0]}" "$first$second" || return 1 ;;
  esac
  [ "$second" = "orphans: none" ] || fail "${FUNCNAME[0]}" "second run printed $second" || return 1
  [ ! -e "$case_dir/mygame-probe" ] || fail "${FUNCNAME[0]}" "worktree left behind" || return 1
  [ "$(refs refs/heads)" = "refs/heads/chore/9-live refs/heads/trunk " ] || fail "${FUNCNAME[0]}" "local $(refs refs/heads)" || return 1
  [ "$(git --git-dir="$case_dir/origin.git" for-each-ref --format='%(refname)' | sort | tr '\n' ' ')" = "refs/heads/chore/9-live refs/heads/trunk " ] ||
    fail "${FUNCNAME[0]}" "origin kept $(git --git-dir="$case_dir/origin.git" for-each-ref --format='%(refname)')" || return 1
  [ "$(sort "$case_dir/state/containers" | tr '\n' ' ')" = "mygame-live-pg mygame-orch-pg " ] || fail "${FUNCNAME[0]}" "containers $(tr '\n' ' ' <"$case_dir/state/containers")" || return 1
  [ "$(cut -f 1 "$case_dir/state/volumes" | sort | tr '\n' ' ')" = "mygame-live-pgdata " ] || fail "${FUNCNAME[0]}" "volumes $(cut -f 1 "$case_dir/state/volumes" | tr '\n' ' ')"
}

orphans_names_a_stray_branch_and_fails() {
  build_a_live_peer stray
  local output status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "orphans: none" ] || fail "${FUNCNAME[0]}" "clean run (exit $status): $output" || return 1
  git -C "$repo" branch stray
  status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -ne 0 ] && [ "$output" = "orphan: branch stray" ] || fail "${FUNCNAME[0]}" "stray run (exit $status): $output"
}

orphans_keeps_a_spared_emulator_only_under_keep_emulator() {
  build_a_merged_ticket_beside_a_live_peer kept
  with_stubs scripts/mygame-wave-close probe --keep-emulator >/dev/null || fail "${FUNCNAME[0]}" "close failed" || return 1
  local output status=0
  output=$(with_stubs scripts/mygame-orphans --keep-emulator) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "kept: emulator $qemu_pid in $case_dir/mygame-probe"$'\n'"orphans: none" ] ||
    fail "${FUNCNAME[0]}" "kept run (exit $status): $output" || return 1
  status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -ne 0 ] && [ "$output" = "orphan: emulator $qemu_pid in missing $case_dir/mygame-probe" ] ||
    fail "${FUNCNAME[0]}" "plain run (exit $status): $output"
}

orphans_reports_only_mygame_dangling_volumes() {
  build_a_live_peer volumes
  local anonymous=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  {
    printf '%s\tcom.docker.volume.anonymous=\n' "$anonymous"
    printf 'mygame-live-scratch\t\n'
    printf 'supabase-db-pichanga\tcom.supabase.cli.project=pichanga\n'
    printf 'mygame_cache\tcom.docker.compose.project=mygame\n'
    printf 'mygame-gone-pgdata\t\n'
  } >"$case_dir/state/volumes"
  local output status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -ne 0 ] && [ "$output" = "orphan: dangling volume mygame_cache"$'\n'"orphan: dangling volume mygame-gone-pgdata" ] ||
    fail "${FUNCNAME[0]}" "exit $status: $output"
}

closing_a_session_on_trunk_keeps_trunk() {
  build_a_live_peer trunk
  git -C "$repo" worktree add -q -f "$case_dir/mygame-probe" trunk
  local output
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  git -C "$repo" show-ref --verify --quiet refs/heads/trunk || fail "${FUNCNAME[0]}" "local trunk deleted: $output" || return 1
  git --git-dir="$case_dir/origin.git" show-ref --verify --quiet refs/heads/trunk || fail "${FUNCNAME[0]}" "origin trunk deleted: $output"
}

orphans_treats_a_same_name_claude_outside_the_worktree_as_not_live() {
  build_a_live_peer elsewhere
  awk -F '\t' -v OFS='\t' -v pid="$live_pid" -v cwd="$case_dir/pichanga-probe" '$1 == pid { $3 = cwd } { print }' \
    "$case_dir/state/processes" >"$case_dir/state/processes.next"
  mv "$case_dir/state/processes.next" "$case_dir/state/processes"
  local output status=0 expected
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  expected=$(printf '%s\n' \
    "orphan: worktree $case_dir/mygame-live" \
    "orphan: branch chore/9-live" \
    "orphan: remote ref refs/remotes/origin/chore/9-live" \
    "orphan: container mygame-live-pg")
  [ "$status" -ne 0 ] && [ "$output" = "$expected" ] || fail "${FUNCNAME[0]}" "exit $status: $output"
}

closing_stops_the_peer_emulator_by_its_avd_and_deletes_the_avd() {
  build_a_peer_with_its_own_avd avd-plain
  local output problem
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid $qemu_pid $probe_emulator_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ "$(deleted)" = "mygame-probe " ] || fail "${FUNCNAME[0]}" "deleted $(deleted)" || return 1
  [ "$(avds)" = "Medium_Phone_5560.avd Medium_Phone_5560.ini hello-1.avd hello-1.ini mygame-live.avd mygame-live.ini mygame-probe2.avd mygame-probe2.ini picantea-reembolso.avd picantea-reembolso.ini " ] ||
    fail "${FUNCNAME[0]}" "avds $(avds)" || return 1
  [ "$(head -n 3 <<<"$output")" = "killed claude -n probe (pid $claude_pid)"$'\n'"stopped emulator mygame-probe (pid $probe_emulator_pid)"$'\n'"deleted avd mygame-probe" ] ||
    fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(tail -n 1 <<<"$output")" = "orphans: none" ] || fail "${FUNCNAME[0]}" "$output" || return 1
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

closing_probe_spares_the_mygame_probe2_emulator_and_avd() {
  build_a_peer_with_its_own_avd avd-prefix
  local output
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  awk -F '\t' -v pid="$probe2_emulator_pid" '$1 == pid { found = 1 } END { exit !found }' "$case_dir/state/processes" ||
    fail "${FUNCNAME[0]}" "the mygame-probe2 emulator was stopped" || return 1
  [ -d "$case_dir/avd/mygame-probe2.avd" ] || fail "${FUNCNAME[0]}" "the mygame-probe2 avd was deleted" || return 1
  case $output in
    *probe2*) fail "${FUNCNAME[0]}" "$output" ;;
  esac
}

closing_stops_an_emulator_found_only_by_its_adb_serial() {
  build_a_merged_ticket_beside_a_live_peer avd-serial
  add_an_avd mygame-probe
  printf '%s\tqemu-system-aarch64-headless\t%s\tqemu-system-aarch64-headless @mygame-probe -port 5568\n' \
    "$serial_only_emulator_pid" "$case_dir" >>"$case_dir/state/processes"
  printf 'emulator-5568\tmygame-probe\t%s\n' "$serial_only_emulator_pid" >>"$case_dir/state/devices"
  local output problem
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid $qemu_pid emulator-5568 " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ "$(deleted)" = "mygame-probe " ] || fail "${FUNCNAME[0]}" "deleted $(deleted)" || return 1
  [ "$(awk 'NR == 2' <<<"$output")" = "stopped emulator mygame-probe (emulator-5568)" ] || fail "${FUNCNAME[0]}" "$output" || return 1
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

keep_emulator_keeps_the_peer_emulator_and_its_avd() {
  build_a_peer_with_its_own_avd avd-keep
  local output problem
  output=$(with_stubs scripts/mygame-wave-close probe --keep-emulator) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ "$(deleted)" = "" ] || fail "${FUNCNAME[0]}" "deleted $(deleted)" || return 1
  [ -d "$case_dir/avd/mygame-probe.avd" ] || fail "${FUNCNAME[0]}" "avd mygame-probe deleted" || return 1
  [ "$(tail -n 4 <<<"$output")" = "kept: avd mygame-probe"$'\n'"kept: emulator $qemu_pid in $case_dir/mygame-probe"$'\n'"kept: emulator $probe_emulator_pid in $case_dir/mygame-probe"$'\n'"orphans: none" ] ||
    fail "${FUNCNAME[0]}" "$output" || return 1
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

closing_without_android_home_stops_the_emulator_and_keeps_the_avd() {
  build_a_peer_with_its_own_avd avd-no-sdk
  local output status=0 problem
  output=$(with_stubs env -u ANDROID_HOME scripts/mygame-wave-close probe) || status=$?
  [ "$status" -eq 0 ] || fail "${FUNCNAME[0]}" "exit $status: $output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid $qemu_pid $probe_emulator_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ -d "$case_dir/avd/mygame-probe.avd" ] || fail "${FUNCNAME[0]}" "avd mygame-probe deleted" || return 1
  case $output in
    *"ANDROID_HOME is unset: avd mygame-probe not deleted"*"orphan: avd mygame-probe"*) ;;
    *) fail "${FUNCNAME[0]}" "$output" || return 1 ;;
  esac
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

closing_twice_skips_the_emulator_and_avd_steps_quietly() {
  build_a_peer_with_its_own_avd avd-twice
  local second
  with_stubs scripts/mygame-wave-close probe >/dev/null || fail "${FUNCNAME[0]}" "first run failed" || return 1
  second=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "second run failed: $second" || return 1
  [ "$second" = "orphans: none" ] || fail "${FUNCNAME[0]}" "second run printed $second"
}

orphans_names_an_avd_without_its_worktree_and_fails() {
  build_a_live_peer avd-orphan
  add_an_avd mygame-gone
  local output status=0 problem
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -ne 0 ] && [ "$output" = "orphan: avd mygame-gone" ] || fail "${FUNCNAME[0]}" "plain run (exit $status): $output" || return 1
  status=0
  output=$(with_stubs scripts/mygame-orphans --keep-emulator) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "kept: avd mygame-gone"$'\n'"orphans: none" ] || fail "${FUNCNAME[0]}" "kept run (exit $status): $output" || return 1
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

orphans_never_reports_a_live_peer_avd_or_another_repo_avd() {
  build_a_live_peer avd-clean
  local output status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "orphans: none" ] || fail "${FUNCNAME[0]}" "plain run (exit $status): $output" || return 1
  status=0
  output=$(with_stubs scripts/mygame-orphans --keep-emulator) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "orphans: none" ] || fail "${FUNCNAME[0]}" "kept run (exit $status): $output"
}

scripts_never_name_a_shared_tool_kill() {
  local found status=0
  found=$(rg -n 'p[k]ill|k[i]llall' "$scripts_dir") || status=$?
  [ "$status" -eq 1 ] || fail "${FUNCNAME[0]}" "rg exit $status: $found"
}

run() {
  if "$1"; then
    echo "ok   $1"
  else
    failures=$((failures + 1))
  fi
}

run spares_the_emulator_under_keep_emulator_and_kills_node
run kills_the_emulator_without_keep_emulator
run closes_an_already_closed_session_quietly
run orphans_names_a_stray_branch_and_fails
run orphans_keeps_a_spared_emulator_only_under_keep_emulator
run orphans_reports_only_mygame_dangling_volumes
run closing_a_session_on_trunk_keeps_trunk
run orphans_treats_a_same_name_claude_outside_the_worktree_as_not_live
run closing_stops_the_peer_emulator_by_its_avd_and_deletes_the_avd
run closing_probe_spares_the_mygame_probe2_emulator_and_avd
run closing_stops_an_emulator_found_only_by_its_adb_serial
run keep_emulator_keeps_the_peer_emulator_and_its_avd
run closing_without_android_home_stops_the_emulator_and_keeps_the_avd
run closing_twice_skips_the_emulator_and_avd_steps_quietly
run orphans_names_an_avd_without_its_worktree_and_fails
run orphans_never_reports_a_live_peer_avd_or_another_repo_avd
run scripts_never_name_a_shared_tool_kill
[ "$failures" -eq 0 ]
