    printf '%s\tadb\t%s\tadb -L tcp:5037 fork-server server --reply-fd 4\n' "$adb_pid" "$case_dir/mygame-gone"
  } >>"$case_dir/state/processes"
  local output status=0
  output=$(with_stubs scripts/mygame-orphans) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "orphans: none" ] || fail "${FUNCNAME[0]}" "plain run (exit $status): $output" || return 1
  status=0
  output=$(with_stubs scripts/mygame-orphans --keep-emulator) || status=$?
  [ "$status" -eq 0 ] && [ "$output" = "orphans: none" ] || fail "${FUNCNAME[0]}" "kept run (exit $status): $output"
}

refuses_an_uppercase_session_name_under_a_utf8_locale() {
  build_a_merged_ticket_beside_a_live_peer uppercase
  local status=0 output
  output=$(with_stubs env LC_ALL=en_US.UTF-8 scripts/mygame-wave-close Probe) || status=$?
  [ "$status" -eq 64 ] || fail "${FUNCNAME[0]}" "exit $status on Probe: $output" || return 1
  [ "$output" = "usage: scripts/mygame-wave-close <session> [--keep-emulator]" ] || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "" ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ -d "$case_dir/mygame-probe" ] || fail "${FUNCNAME[0]}" "the probe worktree is gone"
}

scripts_never_name_a_shared_tool_kill() {
  local found status=0
  found=$(rg -n 'p[k]ill|k[i]llall' "$scripts_dir") || status=$?
  [ "$status" -eq 1 ] || fail "${FUNCNAME[0]}" "rg exit $status: $found"
}

run() {
  if "$1"; then
    echo "ok   $1"
  else
    failures=$((failures + 1))
  fi
}

