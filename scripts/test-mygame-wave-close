closing_the_peer_that_started_netsimd_spares_netsimd_and_adb() {
  build_a_peer_with_its_own_avd netsim
  {
    printf '%s\tnetsimd\t%s\tnetsimd --host-dns=8.8.8.8,8.8.4.4\n' "$netsim_pid" "$case_dir/mygame-probe"
    printf '%s\tadb\t%s\tadb -L tcp:5037 fork-server server --reply-fd 4\n' "$adb_pid" "$case_dir/mygame-probe"
    printf '%s\tnetsimx\t%s\tnetsimx\n' "$netsim_lookalike_pid" "$case_dir/mygame-probe"
  } >>"$case_dir/state/processes"
  local output problem
  output=$(with_stubs scripts/mygame-wave-close probe) || fail "${FUNCNAME[0]}" "$output" || return 1
  [ "$(killed)" = "$claude_pid $node_pid $qemu_pid $probe_emulator_pid $netsim_lookalike_pid " ] || fail "${FUNCNAME[0]}" "killed $(killed)" || return 1
  [ "$(tail -n 1 <<<"$output")" = "orphans: none" ] || fail "${FUNCNAME[0]}" "$output" || return 1
  awk -F '\t' -v pid="$live_emulator_pid" '$1 == pid { found = 1 } END { exit !found }' "$case_dir/state/processes" ||
    fail "${FUNCNAME[0]}" "the live peer emulator was stopped" || return 1
  problem=$(decoys_survive) || fail "${FUNCNAME[0]}" "$problem"
}

