#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$root"

baseline_file=scripts/mygame-structure-check.baseline
api=apps/api/src
domain=packages/domain/src
contracts=packages/contracts/src
web=apps/web/src
folder_limit=30
export_cap=5
method_cap=7

command -v rg >/dev/null || { echo "structure check: rg (ripgrep) is not installed" >&2; exit 2; }
[ -f "$baseline_file" ] || { echo "structure check: $baseline_file is missing" >&2; exit 2; }

search() {
  local status=0
  rg --no-config "$@" || status=$?
  [ "$status" -le 1 ]
}

by_line() {
  awk '{ path = $0; sub(/:.*/, "", path); detail = substr($0, length(path) + 2); print path "\t" detail }'
}

by_file() {
  awk '{ print $0 "\t" }'
}

folders_named() {
  local names=$1
  shift
  search --files "$@" | awk -v names="^($names)$" '
    {
      n = split($0, part, "/")
      path = part[1]
      for (i = 2; i < n; i++) {
        path = path "/" part[i]
        if (part[i] ~ names) print path
      }
    }' | sort -u | by_file
}

class_shape() {
  local method=$1 helpers=$2
  shift 2
  search --files "$@" | awk -v method="$method" -v helpers="$helpers" '
    {
      file = $0
      classes = 0
      built = 0
      asked = 0
      inside = 0
      while ((getline line < file) > 0) {
        if (line ~ /^export class /) { classes++; inside = 1; continue }
        if (!inside) continue
        if (line ~ /^}/) { inside = 0; continue }
        if (line ~ /^  constructor\(/) { built++; continue }
        if (line ~ "^  async " method "\\(") { asked++; continue }
        if (helpers && line ~ /^  private /) continue
        if (line ~ /^  ([a-z#]+ )*[A-Za-z_#][A-Za-z0-9_]*\??(<[^(]*>)?(: | = (async )?)?\(/) print file "\t" "a second method: " line
      }
      close(file)
      if (classes != 1 || built != 1 || asked != 1) print file "\t" "is not one exported class with a constructor and one async " method "("
    }'
}

application_imports_infrastructure() {
  search -n "from '((\.\./)+|#)(\w+/)*infrastructure/" "$api" -g '**/application/**' -g '!*.test.ts' | by_line
}

application_knows_wire() {
  search -n "from '(@mygame/contracts|@?hono|drizzle|zod)" "$api" -g '**/application/**' -g '!*.test.ts' | by_line
}

persistence_knows_http() {
  search -n "from '@?hono" "$api" -g '**/infrastructure/{persistence,catalog,memory,json,smtp,system}/**' -g '!*.test.ts' | by_line
}

api_holds_layer() {
  folders_named 'application|domain' "$api"
}

role_folder() {
  folders_named 'useCases|services|ports' "$domain" && folders_named 'postgres|memory' "$api"
}

file_outside_layer() {
  search --files "$domain" -g '*.ts' | awk -v root="$domain" '
    {
      sub(/\/[^\/]*$/, "")
      if ($0 == root) next
      top = substr($0, length(root) + 2)
      sub(/\/.*/, "", top)
      folder = $0
      sub(/.*\//, "", folder)
      if (top ~ /^(player|time|hash|grid)$/ || folder ~ /^(domain|application|testing)$/) next
      print $0 "\t"
    }' | sort -u
}

route_file() {
  search --files "$api" -g '*Route.ts' -g '*Route.test.ts' | by_file
}

use_case_shape() {
  class_shape execute 0 "$domain" -g '**/application/[A-Z]*.ts' -g '!*.test.ts' -g '!*.testSupport.ts'
}

controller_shape() {
  class_shape handle 1 "$api" -g '**/infrastructure/http/*Controller.ts'
}

use_case_built_outside_root() {
  local classes
  classes=$(search --files "$domain" -g '**/application/[A-Z]*.ts' -g '!*.test.ts' -g '!*.testSupport.ts' | awk '{ sub(/.*\//, ""); sub(/\.ts$/, ""); print }' | paste -sd '|' -) || return 1
  [ -n "$classes" ] || return 0
  search -n "\bnew ($classes)\(" "$api" -g '!*.test.ts' -g '!*.testSupport.ts' -g "!/$api/*.ts" | by_line
}

controller_built_outside_route_list() {
  search -n "\bnew \w+Controller\(" "$api" -g '!*Routes.ts' -g '!*.test.ts' | by_line
}

contracts_outside_adapters() {
  search -n "from '@mygame/contracts'" "$api" -g '!**/infrastructure/http/**' -g '!**/infrastructure/json/**' -g '!**/content/gate/**' -g '!*.test.ts' -g '!*.testSupport.ts' | by_line
}

http_knows_database() {
  search -n "from 'drizzle" "$api" -g '**/infrastructure/http/**' -g '!*.test.ts' | by_line
}

adapter_built_outside_root() {
  search -n "new (Drizzle|Smtp|Argon2|Crypto|System|Vercel)\w*\(" "$api" -g '!*.test.ts' -g '!*.testSupport.ts' -g "!/$api/*.ts" | by_line
}

reading_named_of_is_async() {
  search -l "Promise<|\basync\b" "$api" "$domain" -g '*Of.ts' -g '!*.test.ts' | by_file
}

reading_is_async() {
  local reading="(\w+(?:Of|At|For|Between))\b" parameters="(?:<[^>]*>)?\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)"
  local scope=("$api" "$domain" -g '*.ts' -g '!*.test.ts' -g '!*.testSupport.ts' -g '!**/testing/**')
  {
    search -n -U -o "^[ \t]*(?:export )?(?:default )?(?:async function $reading|function $reading\s*$parameters\s*:\s*Promise<)" -r "function \$1\$2" "${scope[@]}" &&
      search -n -U -o "^[ \t]*(?:export )?const $reading\s*(?:=\s*(?:async\b|$parameters\s*:\s*Promise<)|:\s*$parameters\s*=>\s*Promise<|:[^=\n]*=\s*async\b)" -r "const \$1" "${scope[@]}"
  } | by_line
}

subpath_import_inside_folder() {
  search -n "(from |import\()'#\w+[/']" "$api" "$domain" -g '*.ts' | awk -v q="'" -v api="$api/" -v domain="$domain/" '
    {
      path = $0
      sub(/:.*/, "", path)
      inner = path
      if (index(inner, api) == 1) inner = substr(inner, length(api) + 1)
      else if (index(inner, domain) == 1) inner = substr(inner, length(domain) + 1)
      if (index(inner, "/") == 0) next
      top = inner
      sub(/\/.*/, "", top)
      if (!match($0, q "#[A-Za-z0-9_]+")) next
      if (substr($0, RSTART + 2, RLENGTH - 2) == top) print path "\t" substr($0, length(path) + 2)
    }'
}

production_imports_fakes() {
  local roots=("$api" "$domain" "$contracts")
  [ -d "$web" ] && roots+=("$web")
  search -n "from '(@mygame/domain/testing|#testing'|(\.{1,2}/)+testing'|[^']*/testing/)" "${roots[@]}" -g '*.{ts,tsx}' -g '!*.test.{ts,tsx}' -g '!*.testSupport.ts' -g '!**/testing/**' -g "!/$domain/testing.ts" | by_line
}

use_case_named_of() {
  search --files "$api" "$domain" -g '*Of.ts' -g '!*.test.ts' | { search '/(application|useCases|services)/'; } | by_file
}

domain_promise_outside_its_roles() {
  local scope=("$domain" -g '!**/useCases/**' -g '!**/services/**' -g '!**/application/**' -g '!**/testing/**' -g '!*.test.ts')
  {
    search -l '\basync\b' "${scope[@]}" &&
      search -l 'Promise<' "${scope[@]}" | awk '
        {
          file = $0
          port = 0
          while ((getline line < file) > 0) if (line ~ /^export interface /) port = 1
          close(file)
          if (!port) print file
        }'
  } | sort -u | by_file
}

use_case_imports_use_case() {
  local use_case="((\.\./)+|#)(\w+/)*application/[A-Z]"
  {
    search -n "from '(\./|((\.\./)+|#)(\w+/)*useCases/|$use_case)" "$domain" -g '**/useCases/**' -g '!*.test.ts' &&
      search -n "from '(\./[A-Z]|$use_case)" "$domain" -g '**/application/**' -g '!*.test.ts'
  } | by_line
}

step_is_public() {
  search -n "/services/|/application/[a-z]" "$domain/index.ts" | awk -v file="$domain/index.ts" '{ print file "\t" $0 }'
}

folder_over_limit() {
  search --files "$api" "$domain" "$contracts" -g '*.ts' -g '!*.test.ts' -g '!*.testSupport.ts' |
    awk -v limit="$folder_limit" '
      { sub(/\/[^\/]*$/, ""); count[$0]++ }
      END { for (folder in count) if (count[folder] > limit) print folder "\t" count[folder] " production files" }'
}

file_over_export_cap() {
  search -c '^export ' "$api" "$domain" "$contracts" -g '*.ts' -g '!*.test.ts' -g '!*.testSupport.ts' -g '!**/testing/**' -g '!index.ts' -g "!/$domain/testing.ts" -g '!*Tables.ts' |
    awk -F: -v cap="$export_cap" '$2 > cap { print $1 "\t" $2 " exports" }'
}

type_over_method_cap() {
  search --files "$api" "$domain" "$contracts" -g '*.ts' -g '!*.test.ts' -g '!*.testSupport.ts' -g '!**/testing/**' |
    awk -v cap="$method_cap" '
      {
        file = $0
        type = ""
        while ((getline line < file) > 0) {
          if (line ~ /^(export )?(abstract )?(class|interface) /) { type = line; n = 0; continue }
          if (type == "") continue
          if (line ~ /^}/) { if (n > cap) print file "\t" n " methods in " type; type = ""; continue }
          if (line ~ /^  (static )?(get|set) / || line ~ /^  (private |protected )?constructor\(/) continue
          if (line ~ /^  ([a-z#]+ )*[A-Za-z_][A-Za-z0-9_]*\??(<[^(]*>)?(: | = (async )?)?\(/) n++
        }
        close(file)
      }'
}

checks=(
  application_imports_infrastructure
  application_knows_wire
  subpath_import_inside_folder
  contracts_outside_adapters
  persistence_knows_http
  http_knows_database
  adapter_built_outside_root
  reading_named_of_is_async
  reading_is_async
  production_imports_fakes
  use_case_named_of
  domain_promise_outside_its_roles
  use_case_imports_use_case
  step_is_public
  api_holds_layer
  role_folder
  file_outside_layer
  route_file
  use_case_shape
  controller_shape
  use_case_built_outside_root
  controller_built_outside_route_list
  folder_over_limit
  file_over_export_cap
  type_over_method_cap
)

failures=0

report() {
  printf '%s\n' "$1" >&2
  failures=$((failures + 1))
}

known_check() {
  local check
  for check in "${checks[@]}"; do
    [ "$check" = "$1" ] && return 0
  done
  return 1
}

while read -r check path rest; do
  [ -n "$check" ] || continue
  known_check "$check" || report "structure baseline: '$check $path' names no check"
  [ -n "$path" ] && [ -z "$rest" ] || report "structure baseline: '$check $path $rest' is not '<check> <path>'"
done <"$baseline_file"

for check in "${checks[@]}"; do
  hits=$("$check") || { report "structure check $check: the search failed"; continue; }
  baselined=$(awk -v check="$check" '$1 == check { print $2 }' "$baseline_file" | sort -u)
  hit_paths=$(printf '%s\n' "$hits" | awk -F'\t' 'NF { print $1 }' | sort -u)
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    printf '%s\n' "$baselined" | rg --no-config -qxF -- "$path" && continue
    printf '%s\n' "$hits" | awk -F'\t' -v path="$path" -v check="$check" '$1 == path { print "structure check " check " " path " " $2 }' >&2
    failures=$((failures + 1))
  done <<<"$hit_paths"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    printf '%s\n' "$hit_paths" | rg --no-config -qxF -- "$path" && continue
    report "structure baseline $check: $path no longer fails; delete its line from $baseline_file"
  done <<<"$baselined"
done

map=ARCHITECTURE.md
shopt -s nullglob
folders=$(for folder in "$api"/*/ "$domain"/*/; do basename "$folder"; done | sort -u)
if rows=$(search -o "^\\| \`(\\w+)\` \\|" -r "\$1" "$map"); then
  map_diff=$(diff <(printf '%s\n' "$folders") <(printf '%s\n' "$rows" | sort -u)) || {
    report "structure check map: the folders under $api and $domain and the rows of $map differ (< folder only, > row only):"
    printf '%s\n' "$map_diff" >&2
  }
else
  report "structure check map: $map could not be read"
fi

if [ "$failures" -gt 0 ]; then
  echo "structure check: $failures failure(s)" >&2
  exit 1
fi
