#!/usr/bin/env bash
set -euo pipefail

input=$(</dev/stdin)
[[ $input == *gh*pr* ]] || exit 0

status=0
printf '%s' "$input" | python3 -I -c '
import json, os, re, shlex, subprocess, sys

hook = json.load(sys.stdin)
command = hook["tool_input"]["command"]
repo_flag = r"(?:\s+(?:-R\s*|--repo(?:\s+|=))\S+)*"
if not re.search(r"(?:^|[;&|(\n])\s*(?:\w+=\S*\s+)*gh" + repo_flag + r"\s+pr" + repo_flag + r"\s+(?:create|new)", command):
    sys.exit(0)
cwd = hook["cwd"]

audit_script = os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])), "mygame-branch-audit")
audit = subprocess.run([audit_script], cwd=cwd, capture_output=True, text=True)
if audit.returncode != 0:
    print(f"Blocked: scripts/mygame-branch-audit failed in {cwd}", file=sys.stderr)
    print(audit.stderr, end="", file=sys.stderr)
    sys.exit(2)
audited = audit.stdout.split()

def body_of(command):
    heredoc = re.search(r"(?:--body|-b) \"\$\(cat <<\x27(\w+)\x27\n(.*?)\n\1\n", command, re.S)
    if heredoc:
        return heredoc.group(2)
    try:
        words = shlex.split(command)
    except ValueError:
        return ""
    for flag, value in zip(words, words[1:]):
        if flag in ("--body", "-b"):
            return value
        if flag in ("--body-file", "-F"):
            try:
                return open(os.path.join(cwd, value)).read()
            except OSError:
                return ""
    return ""

covered = set()
for row in body_of(command).splitlines():
    if not row.startswith("|"):
        continue
    first, test = (re.split(r"(?<!\\)\|", row) + ["", "", ""])[1:3]
    if test.replace("`", "").strip() == "no behavior:":
        continue
    covered.update(first.replace("`", " ").split())

missing = [entry for entry in audited if entry not in covered]
if missing:
    print("Blocked: no red-run row for", file=sys.stderr)
    print("\n".join(missing), file=sys.stderr)
    sys.exit(2)
' "${BASH_SOURCE[0]}" || status=$?
case $status in
  0 | 2) exit "$status" ;;
esac
echo "Blocked: scripts/mygame-red-run-check failed with exit $status" >&2
exit 2
