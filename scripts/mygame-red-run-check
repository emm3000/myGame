#!/usr/bin/env bash
set -euo pipefail

input=$(</dev/stdin)
[[ $input == *gh*pr* ]] || exit 0

status=0
printf '%s' "$input" | python3 -I -c '
import json, os, re, shlex, subprocess, sys

heredoc_operator = re.compile(r"(?<!<)<<(-?)\s*([\x27\"]?)(\w+)\2")

def heredoc_bodies_end(command, at, heredocs):
    for strip_tabs, delimiter in heredocs:
        while at < len(command):
            line_end = command.find("\n", at)
            line_end = len(command) if line_end < 0 else line_end
            line = command[at:line_end]
            at = line_end + 1
            if (line.lstrip("\t") if strip_tabs else line) == delimiter:
                break
    return at

def unquoted(command):
    kept = []
    open_quotes = []
    heredocs = []
    at = 0
    while at < len(command):
        quote = open_quotes[-1] if open_quotes else ""
        char = command[at]
        if quote == "\x27":
            if char == "\x27":
                open_quotes.pop()
            kept.append(char if char == "\x27" else " ")
        elif quote == "\"" and command.startswith("\x24(", at):
            open_quotes.append("(")
            kept.append("\x24(")
            at += 2
            continue
        elif quote == "\"":
            if char == "\\":
                kept.append("  ")
                at += 2
                continue
            if char == "\"":
                open_quotes.pop()
            kept.append(char if char == "\"" else " ")
        else:
            heredoc = heredoc_operator.match(command, at)
            if heredoc:
                heredocs.append((heredoc.group(1) == "-", heredoc.group(3)))
                kept.append(" " * len(heredoc.group(0)))
                at = heredoc.end()
                continue
            if char == "\n" and heredocs:
                body_end = heredoc_bodies_end(command, at + 1, heredocs)
                kept.append(re.sub(r"[^\n]", " ", command[at:body_end]))
                heredocs = []
                at = body_end
                continue
            if char == "#" and (at == 0 or command[at - 1] in " \t\n;&|("):
                line_end = command.find("\n", at)
                line_end = len(command) if line_end < 0 else line_end
                kept.append(" " * (line_end - at))
                at = line_end
                continue
            if char == "\\":
                kept.append(command[at:at + 2])
                at += 2
                continue
            if char in "\x27\"(":
                open_quotes.append(char)
            elif char == ")" and quote == "(":
                open_quotes.pop()
            kept.append(char)
        at += 1
    return command if open_quotes else "".join(kept)

hook = json.load(sys.stdin)
command = hook["tool_input"]["command"]
repo_flag = r"(?:\s+(?:-R\s*|--repo(?:\s+|=))\S+)*"
assignments = r"(?:\w+=\S*\s+)*"
prefixes = r"(?:(?:if|!|\{|command|env)\s+" + assignments + r")*"
gh = r"(?:\S*/)?gh"
if not re.search(r"(?:^|[;&|(\n])[ \t]*" + assignments + prefixes + gh + repo_flag + r"\s+pr" + repo_flag + r"\s+(?:create|new)\b", unquoted(command)):
    sys.exit(0)
cwd = hook["cwd"]

audit_script = os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])), "mygame-branch-audit")
audit = subprocess.run([audit_script], cwd=cwd, capture_output=True, text=True)
if audit.returncode != 0:
    print(f"Blocked: scripts/mygame-branch-audit failed in {cwd}", file=sys.stderr)
    print(audit.stderr, end="", file=sys.stderr)
    sys.exit(2)
audited = audit.stdout.split()

def body_of(command):
    heredoc = re.search(r"(?:--body|-b) \"\$\(cat <<\x27(\w+)\x27\n(.*?)\n\1\n", command, re.S)
    if heredoc:
        return heredoc.group(2)
    try:
        words = shlex.split(command)
    except ValueError:
        return ""
    for flag, value in zip(words, words[1:]):
        if flag in ("--body", "-b"):
            return value
        if flag in ("--body-file", "-F"):
            try:
                return open(os.path.join(cwd, value)).read()
            except OSError:
                return ""
    return ""

covered = set()
for row in body_of(command).splitlines():
    if not row.startswith("|"):
        continue
    first, test = (re.split(r"(?<!\\)\|", row) + ["", "", ""])[1:3]
    if test.replace("`", "").strip() == "no behavior:":
        continue
    covered.update(first.replace("`", " ").split())

missing = [entry for entry in audited if entry not in covered]
if missing:
    print("Blocked: no red-run row for", file=sys.stderr)
    print("\n".join(missing), file=sys.stderr)
    sys.exit(2)
' "${BASH_SOURCE[0]}" || status=$?
case $status in
  0 | 2) exit "$status" ;;
esac
echo "Blocked: scripts/mygame-red-run-check failed with exit $status" >&2
exit 2
