#!/usr/bin/env bash
set -euo pipefail

scripts_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
settings="$scripts_dir/../.claude/settings.json"

while IFS= read -r variable; do
  unset "$variable"
done < <(compgen -e | awk '/^GIT_/')
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.invalid
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.invalid

temp_base=${TMPDIR:-/tmp}
sandbox=$(mktemp -d "${temp_base%/}/red-run-check-test.XXXXXX") || { echo "refusing the sandbox: mktemp -d failed" >&2; exit 70; }
[ -n "$sandbox" ] && [ -d "$sandbox" ] || { echo "refusing the sandbox: mktemp -d printed no directory" >&2; exit 70; }
sandbox=$(cd "$sandbox" && pwd -P)
case $sandbox in
  "$(cd "$temp_base" && pwd -P)"/?*) ;;
  *) echo "refusing the sandbox: $sandbox is not under $temp_base" >&2; exit 70 ;;
esac
trap 'rm -rf "$sandbox"' EXIT
export GIT_CEILING_DIRECTORIES="$sandbox"

failures=0
repo="$sandbox/myGame"
clean="$sandbox/clean"
outside="$sandbox/outside"
audit_log="$sandbox/audit-runs"
status=0
out=""
err=""

mkdir -p "$sandbox/scripts" "$outside"
cp "$scripts_dir/mygame-red-run-check" "$sandbox/scripts/"
{
  echo '#!/usr/bin/env bash'
  echo "echo run >>'$audit_log'"
  echo "exec '$scripts_dir/mygame-branch-audit' \"\$@\""
} >"$sandbox/scripts/mygame-branch-audit"
chmod +x "$sandbox/scripts/mygame-branch-audit"

write() {
  mkdir -p "$(dirname "$1")"
  awk 1 >"$1"
}

build_a_repo() {
  local dir=$1
  mkdir -p "$dir"
  (cd "$dir" && git init -q -b trunk)
  printf 'export const a = 1;\n' | write "$dir/src/a.ts"
  printf 'package b\n\nfun b(): Int = 1\n' | write "$dir/src/b.kt"
  (cd "$dir" && git add -A && git commit -q -m base && git update-ref refs/remotes/origin/trunk HEAD && git switch -q -c feature)
}

build_the_fixture_repos() {
  build_a_repo "$repo"
  printf 'export const a = 1;\nif (a) {}\n' | write "$repo/src/a.ts"
  printf 'package b\n\nfun b(x: Boolean): Int { if (x) return 1; return 0 }\n' | write "$repo/src/b.kt"
  (cd "$repo" && git add -A && git commit -q -m feature)
  build_a_repo "$clean"
}

full_body() {
  printf '%s\n' \
    'Closes #1' \
    '' \
    '| Rule, branch or guard | Test | Mutation | Failing assertion line |' \
    '|---|---|---|---|' \
    "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" \
    "| src/b.kt:3 the if | \`b test\` | drop it | FAIL b |"
}

hook() {
  local command=$1 cwd=${2:-$repo}
  : >"$audit_log"
  status=0
  out=$(jq -n --arg command "$command" --arg cwd "$cwd" \
    '{hook_event_name: "PreToolUse", tool_name: "Bash", tool_input: {command: $command}, cwd: $cwd}' |
    (cd "$sandbox" && scripts/mygame-red-run-check) 2>"$sandbox/stderr") || status=$?
  err=$(<"$sandbox/stderr")
}

fail() {
  printf 'FAIL %s: %s\n' "$1" "$2" >&2
  return 1
}

expect_pass() {
  [ "$status" -eq 0 ] && [ -z "$out" ] && [ -z "$err" ] || fail "$1" "exit $status, stdout '$out', stderr '$err'"
}

expect_blocked_for() {
  local test=$1 expected
  shift
  expected=$(printf '%s\n' 'Blocked: no red-run row for' "$@")
  [ "$status" -eq 2 ] && [ -z "$out" ] && [ "$err" = "$expected" ] || fail "$test" "exit $status, stderr '$err'"
}

body_with_rows() {
  printf '%s\n' '| Rule, branch or guard | Test | Mutation | Failing assertion line |' '|---|---|---|---|' "$@"
}

passes_a_command_that_is_not_gh_pr_create_without_running_the_audit() {
  local command
  for command in \
    "git status" \
    "gh pr view 3 --json body" \
    "echo gh pr create" \
    "rg -n 'gh pr create' docs" \
    "git commit -m \"feat(agents): block gh pr create without a row\"" \
    "gh issue create --title t --body \"a hook that blocks gh pr create\"" \
    "gh pr newer --fill" \
    "gh pr creates --fill" \
    "ifgh pr create --fill" \
    "commandgh pr create --fill"; do
    hook "$command"
    expect_pass "${FUNCNAME[0]}" || return 1
    [ ! -s "$audit_log" ] || fail "${FUNCNAME[0]}" "'$command' ran the audit" || return 1
  done
}

checks_gh_pr_create_run_as_a_command() {
  local command
  for command in \
    "cd . ; gh pr create --fill" \
    "cd . && gh pr create --fill" \
    "true | gh pr create --fill" \
    "(gh pr create --fill)" \
    "cd .
gh pr create --fill" \
    "GH_PROMPT_DISABLED=1 gh pr create --fill" \
    "gh pr new --fill" \
    "gh -R a/b pr create --fill" \
    "gh pr -Ra/b create --fill" \
    "gh --repo a/b pr create --fill" \
    "gh pr --repo=a/b new --fill" \
    "if gh pr create --fill; then :; fi" \
    "{ gh pr create --fill; }" \
    "! gh pr new --fill" \
    "command gh pr create --fill" \
    "env gh pr create --fill" \
    "env GH_PROMPT_DISABLED=1 gh pr create --fill" \
    "command env gh pr create --fill" \
    "/opt/homebrew/bin/gh pr create --fill" \
    "cd . && ./bin/gh pr create --fill"; do
    hook "$command"
    expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3 || fail "${FUNCNAME[0]}" "'$command' was not checked" || return 1
  done
}

passes_a_commit_quoting_gh_pr_new_without_reading_its_message_file() {
  printf 'docs: name the gh pr new flow\n' | write "$repo/notes/message.txt"
  hook "git commit -F notes/message.txt -m 'docs; gh pr new flow'"
  expect_pass "${FUNCNAME[0]}" || return 1
  [ ! -s "$audit_log" ] || fail "${FUNCNAME[0]}" "the audit ran, so the message file was read as a body"
}

passes_a_command_quoting_gh_pr_create_after_a_separator() {
  local command
  for command in \
    "echo 'a; gh pr create --fill'" \
    "echo \"a && gh pr create --fill\"" \
    "echo 'a
gh pr create --fill'" \
    "echo \"a \\\" ; gh pr create --fill\"" \
    "echo \"\$(date); gh pr create --fill\"" \
    "echo \"\$( (cd .) ; echo \" ; gh pr new \" )\""; do
    hook "$command"
    expect_pass "${FUNCNAME[0]}" || fail "${FUNCNAME[0]}" "'$command' was checked" || return 1
    [ ! -s "$audit_log" ] || fail "${FUNCNAME[0]}" "'$command' ran the audit" || return 1
  done
}

checks_gh_pr_create_inside_a_command_substitution_in_double_quotes() {
  hook "url=\"\$(gh pr create --fill)\""
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

checks_gh_pr_create_after_a_closed_or_escaped_quote() {
  local command
  for command in \
    "echo 'done'; gh pr create --fill" \
    "echo \"done\" && gh pr create --fill" \
    "echo it\\'s; gh pr create --fill" \
    "echo \"\$(date)\"; gh pr create --fill"; do
    hook "$command"
    expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3 || fail "${FUNCNAME[0]}" "'$command' was not checked" || return 1
  done
}

checks_gh_pr_create_after_a_heredoc_or_a_comment_holding_an_apostrophe() {
  local command tab=$'\t'
  printf 'Closes #1\n' | write "$repo/notes/plain.md"
  for command in \
    "git commit -m \"\$(cat <<'EOF'
fix: don't drop it
EOF
)\" && gh pr create --body-file notes/plain.md" \
    "cat << \"EOF\"
don't
EOF
gh pr create --fill" \
    "cat <<EOF
don't
EOF
true
gh pr create --fill" \
    "cat <<-EOF
${tab}don't
${tab}EOF
gh pr create --fill" \
    "cat <<<'x'
gh pr create --fill" \
    "# don't forget
gh pr create --fill" \
    "echo a#b; gh pr create --fill" \
    "echo \$'it\\'s'; gh pr create --fill"; do
    hook "$command"
    expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3 || fail "${FUNCNAME[0]}" "'$command' was not checked" || return 1
  done
}

passes_a_command_quoting_gh_pr_create_inside_a_heredoc_or_a_comment() {
  local command tab=$'\t'
  for command in \
    "cat <<'EOF'
a; gh pr create --fill
EOF" \
    "cat << 'EOF'
a; gh pr create --fill
EOF" \
    "echo it\\'s 'a; gh pr create --fill'" \
    "echo done # ; gh pr create --fill" \
    "# a; gh pr create --fill" \
    "true
# a; gh pr create --fill" \
    "true;# a; gh pr create --fill" \
    "true${tab}# a; gh pr create --fill" \
    "true&# a; gh pr create --fill" \
    "true|# a; gh pr create --fill" \
    "(# a; gh pr create --fill
)"; do
    hook "$command"
    expect_pass "${FUNCNAME[0]}" || fail "${FUNCNAME[0]}" "'$command' was checked" || return 1
  done
}

blocks_a_body_file_with_no_row_naming_every_line() {
  printf 'Closes #1\n\nNo table here.\n' | write "$repo/notes/plain.md"
  hook "gh pr create --title t --body-file notes/plain.md"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

checks_gh_pr_create_spelled_with_extra_whitespace() {
  hook "cd . &&  gh  pr   create --fill"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

blocks_a_body_missing_one_row_and_names_exactly_that_path_line() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |")'"
  expect_blocked_for "${FUNCNAME[0]}" src/b.kt:3
}

passes_a_long_body_flag_covering_every_line() {
  hook "gh pr create --title t --body '$(full_body)'"
  expect_pass "${FUNCNAME[0]}"
}

passes_a_short_body_flag_covering_every_line() {
  hook "gh pr create --title t -b '$(full_body)'"
  expect_pass "${FUNCNAME[0]}"
}

reads_a_long_body_flag_heredoc_holding_a_lone_double_quote() {
  hook "gh pr create --title t --body \"\$(cat <<'PRBODY'
$(full_body)
A 5\" screen.
PRBODY
)\""
  expect_pass "${FUNCNAME[0]}"
}

reads_a_short_body_flag_heredoc_holding_a_lone_double_quote() {
  hook "gh pr create --title t -b \"\$(cat <<'EOF'
$(full_body)
A 5\" screen.
EOF
)\""
  expect_pass "${FUNCNAME[0]}"
}

reads_a_long_body_file_relative_to_the_hook_cwd() {
  full_body | write "$repo/notes/body.md"
  hook "gh pr create --title t --body-file notes/body.md"
  expect_pass "${FUNCNAME[0]}"
}

reads_a_short_body_file_relative_to_the_hook_cwd() {
  full_body | write "$repo/notes/body.md"
  hook "gh pr create --title t -F notes/body.md"
  expect_pass "${FUNCNAME[0]}"
}

blocks_a_missing_body_file_naming_every_line() {
  hook "gh pr create --title t --body-file notes/missing.md"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

blocks_a_command_with_no_body_naming_every_line() {
  hook "gh pr create --fill"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

blocks_a_body_with_no_table_naming_every_line() {
  hook "gh pr create --title t --body 'Closes #1; tested as a | src/a.ts:2 | src/b.kt:3 in prose.'"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

blocks_a_command_that_does_not_parse_naming_every_line() {
  hook "gh pr create --title t --body \"$(full_body)"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

passes_an_exemption_row_with_a_reason() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" '| src/b.kt:3 a log guard | no behavior: only the log line changes | none | none |')'"
  expect_pass "${FUNCNAME[0]}"
}

blocks_an_exemption_row_with_an_empty_reason() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" '| src/b.kt:3 a log guard | no behavior:   | none | none |')'"
  expect_blocked_for "${FUNCNAME[0]}" src/b.kt:3
}

blocks_a_backticked_exemption_with_no_reason() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" "| src/b.kt:3 a log guard | \`no behavior:\` | none | none |")'"
  expect_blocked_for "${FUNCNAME[0]}" src/b.kt:3
}

covers_only_from_the_first_cell() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" "| the if | \`b test\` | src/b.kt:3 | FAIL b |")'"
  expect_blocked_for "${FUNCNAME[0]}" src/b.kt:3
}

covers_only_the_exact_path_line() {
  hook "gh pr create --title t --body '$(body_with_rows "| src/a.ts:20 the if | \`a test\` | drop it | FAIL a |" "| lib/src/b.kt:3 the if | \`b test\` | drop it | FAIL b |")'"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3
}

covers_a_backticked_path_line() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" "| \`src/b.kt:3\` the if | \`b test\` | drop it | FAIL b |")'"
  expect_pass "${FUNCNAME[0]}"
}

covers_a_row_without_a_closing_pipe() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" "| src/b.kt:3 the if")'"
  expect_pass "${FUNCNAME[0]}"
}

keeps_an_escaped_pipe_inside_the_first_cell() {
  hook "gh pr create --title t --body '$(body_with_rows "| \`src/a.ts:2\` the if | \`a test\` | drop it | FAIL a |" "| \`a\|b\` guard src/b.kt:3 | \`b test\` | drop it | FAIL b |")'"
  expect_pass "${FUNCNAME[0]}"
}

passes_without_a_body_when_the_audit_lists_nothing() {
  hook "gh pr create --fill" "$clean"
  expect_pass "${FUNCNAME[0]}" || return 1
  [ -s "$audit_log" ] || fail "${FUNCNAME[0]}" "the audit did not run"
}

runs_the_audit_in_the_hook_cwd() {
  hook "gh pr create --fill" "$repo"
  expect_blocked_for "${FUNCNAME[0]}" src/a.ts:2 src/b.kt:3 || return 1
  hook "gh pr create --fill" "$clean"
  expect_pass "${FUNCNAME[0]}"
}

blocks_when_the_audit_fails() {
  hook "gh pr create --title t --body '$(full_body)'" "$outside"
  [ "$status" -eq 2 ] && [ -z "$out" ] || fail "${FUNCNAME[0]}" "exit $status, stdout '$out'" || return 1
  [ "$(printf '%s\n' "$err" | head -n 1)" = "Blocked: scripts/mygame-branch-audit failed in $outside" ] || fail "${FUNCNAME[0]}" "stderr '$err'" || return 1
  printf '%s\n' "$err" | rg -q '^fatal: not a git repository' || fail "${FUNCNAME[0]}" "the audit error is not passed on: '$err'"
}

expect_failed_closed() {
  local test=$1 cause=$2 code=$3
  [ "$status" -eq 2 ] && [ -z "$out" ] || fail "$test" "exit $status, stdout '$out', stderr '$err'" || return 1
  [ "$(printf '%s\n' "$err" | tail -n 1)" = "Blocked: scripts/mygame-red-run-check failed with exit $code" ] || fail "$test" "stderr '$err'" || return 1
  printf '%s\n' "$err" | rg -qF -- "$cause" || fail "$test" "the cause '$cause' is not on stderr: '$err'"
}

passes_a_command_that_is_not_gh_pr_create_without_a_cwd() {
  status=0
  out=$(jq -n '{tool_input: {command: "gh pr view 3 --json body"}}' | (cd "$sandbox" && scripts/mygame-red-run-check) 2>"$sandbox/stderr") || status=$?
  err=$(<"$sandbox/stderr")
  expect_pass "${FUNCNAME[0]}"
}

fails_closed_on_a_body_file_that_is_not_utf_8() {
  printf '\xff\xfe not utf-8\n' | write "$repo/notes/latin.md"
  hook "gh pr create --title t --body-file notes/latin.md"
  expect_failed_closed "${FUNCNAME[0]}" UnicodeDecodeError 1
}

fails_closed_on_a_missing_cwd() {
  hook "gh pr create --fill" "$sandbox/gone"
  expect_failed_closed "${FUNCNAME[0]}" FileNotFoundError 1
}

fails_closed_on_input_that_is_not_json() {
  status=0
  out=$(printf 'not json: gh pr create\n' | (cd "$sandbox" && scripts/mygame-red-run-check) 2>"$sandbox/stderr") || status=$?
  err=$(<"$sandbox/stderr")
  expect_failed_closed "${FUNCNAME[0]}" JSONDecodeError 1
}

fails_closed_on_a_missing_audit_script() {
  local result=0
  mv "$sandbox/scripts/mygame-branch-audit" "$sandbox/audit-aside"
  hook "gh pr create --title t --body '$(full_body)'"
  mv "$sandbox/audit-aside" "$sandbox/scripts/mygame-branch-audit"
  expect_failed_closed "${FUNCNAME[0]}" FileNotFoundError 1 || result=1
  return "$result"
}

fails_closed_on_an_audit_script_that_is_not_executable() {
  local result=0
  chmod -x "$sandbox/scripts/mygame-branch-audit"
  hook "gh pr create --title t --body '$(full_body)'"
  chmod +x "$sandbox/scripts/mygame-branch-audit"
  expect_failed_closed "${FUNCNAME[0]}" PermissionError 1 || result=1
  return "$result"
}

hook_without_python3() {
  local bin="$sandbox/bin-without-python"
  mkdir -p "$bin"
  ln -sf "$(command -v bash)" "$bin/bash"
  status=0
  out=$(jq -n --arg command "$1" --arg cwd "$repo" '{tool_input: {command: $command}, cwd: $cwd}' |
    (cd "$sandbox" && PATH="$bin" scripts/mygame-red-run-check) 2>"$sandbox/stderr") || status=$?
  err=$(<"$sandbox/stderr")
}

passes_a_command_with_no_gh_pr_without_python3() {
  hook_without_python3 "git status"
  expect_pass "${FUNCNAME[0]}"
}

fails_closed_on_gh_pr_create_without_python3() {
  hook_without_python3 "gh pr create --fill"
  expect_failed_closed "${FUNCNAME[0]}" python3 127
}

settings_run_the_check_through_the_project_dir() {
  local entry
  entry=$(jq -r '[.hooks.PreToolUse[] | select(.matcher == "Bash") | .hooks[].command | select(test("mygame-red-run-check"))] | .[0] // ""' "$settings")
  [ "$entry" = "\"\$CLAUDE_PROJECT_DIR\"/scripts/mygame-red-run-check" ] || fail "${FUNCNAME[0]}" "entry '$entry'" || return 1
  status=0
  err=$(jq -n --arg cwd "$repo" '{tool_input: {command: "gh pr create --fill"}, cwd: $cwd}' |
    (cd "$outside" && CLAUDE_PROJECT_DIR="$sandbox" bash -c "$entry") 2>&1) || status=$?
  [ "$status" -eq 2 ] && [ "$err" = "$(printf '%s\n' 'Blocked: no red-run row for' src/a.ts:2 src/b.kt:3)" ] || fail "${FUNCNAME[0]}" "exit $status: $err"
}

run() {
  if "$1"; then
    echo "ok   $1"
  else
    failures=$((failures + 1))
  fi
}

build_the_fixture_repos
run passes_a_command_that_is_not_gh_pr_create_without_running_the_audit
run checks_gh_pr_create_run_as_a_command
run passes_a_commit_quoting_gh_pr_new_without_reading_its_message_file
run passes_a_command_quoting_gh_pr_create_after_a_separator
run checks_gh_pr_create_inside_a_command_substitution_in_double_quotes
run checks_gh_pr_create_after_a_closed_or_escaped_quote
run checks_gh_pr_create_after_a_heredoc_or_a_comment_holding_an_apostrophe
run passes_a_command_quoting_gh_pr_create_inside_a_heredoc_or_a_comment
run blocks_a_body_file_with_no_row_naming_every_line
run checks_gh_pr_create_spelled_with_extra_whitespace
run blocks_a_body_missing_one_row_and_names_exactly_that_path_line
run passes_a_long_body_flag_covering_every_line
run passes_a_short_body_flag_covering_every_line
run reads_a_long_body_flag_heredoc_holding_a_lone_double_quote
run reads_a_short_body_flag_heredoc_holding_a_lone_double_quote
run reads_a_long_body_file_relative_to_the_hook_cwd
run reads_a_short_body_file_relative_to_the_hook_cwd
run blocks_a_missing_body_file_naming_every_line
run blocks_a_command_with_no_body_naming_every_line
run blocks_a_body_with_no_table_naming_every_line
run blocks_a_command_that_does_not_parse_naming_every_line
run passes_an_exemption_row_with_a_reason
run blocks_an_exemption_row_with_an_empty_reason
run blocks_a_backticked_exemption_with_no_reason
run covers_only_from_the_first_cell
run covers_only_the_exact_path_line
run covers_a_backticked_path_line
run covers_a_row_without_a_closing_pipe
run keeps_an_escaped_pipe_inside_the_first_cell
run passes_without_a_body_when_the_audit_lists_nothing
run runs_the_audit_in_the_hook_cwd
run blocks_when_the_audit_fails
run passes_a_command_that_is_not_gh_pr_create_without_a_cwd
run fails_closed_on_a_body_file_that_is_not_utf_8
run fails_closed_on_a_missing_cwd
run fails_closed_on_input_that_is_not_json
run fails_closed_on_a_missing_audit_script
run fails_closed_on_an_audit_script_that_is_not_executable
run passes_a_command_with_no_gh_pr_without_python3
run fails_closed_on_gh_pr_create_without_python3
run settings_run_the_check_through_the_project_dir
[ "$failures" -eq 0 ]
