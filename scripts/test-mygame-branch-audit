  expect_nothing_listed_under "${FUNCNAME[0]}" apps/web/src/legacy.js || return 1
  expect_nothing_listed_under "${FUNCNAME[0]}" docs/notes.md
}

prints_a_line_with_two_tokens_once() {
  local output count
  output=$(audit) || fail "${FUNCNAME[0]}" "exit $?" || return 1
  local entry
  for entry in "$kotlin:26" "$typescript:25"; do
    count=$(printf '%s\n' "$output" | rg -cxF -- "$entry" || true)
    [ "$count" = 1 ] || fail "${FUNCNAME[0]}" "$entry printed ${count:-0} times" || return 1
  done
}

expected_list() {
  local entry
  for entry in 13 14 15 16 18 19 20 21 22 26 30 38 41 42 45 49 50 51 52 54 55 56 62 75 76 77 78 79; do echo "$kotlin:$entry"; done
  for entry in 2 9 13; do echo "$tsx:$entry"; done
  for entry in 11 14 15 21 25 32 37 39 44 47 53; do echo "$typescript:$entry"; done
  echo "$non_ascii:1"
}

prints_exactly_the_sorted_path_line_list_and_nothing_else() {
  local output
  output=$(audit 2>/dev/null) || fail "${FUNCNAME[0]}" "exit $?" || return 1
  [ "$output" = "$(expected_list)" ] || fail "${FUNCNAME[0]}" "got $(printf '%s' "$output" | tr '\n' ' ')"
}

writes_nothing_to_stderr() {
  local errors
  errors=$(audit 2>&1 >/dev/null) || fail "${FUNCNAME[0]}" "exit $?" || return 1
  [ -z "$errors" ] || fail "${FUNCNAME[0]}" "stderr: $errors"
}

runs_from_a_subdirectory_with_paths_from_the_repo_root() {
  local output
  output=$(cd "$repo/apps/web" && /usr/bin/timeout -k 1 20 "$scripts_dir/mygame-branch-audit") || fail "${FUNCNAME[0]}" "exit $?" || return 1
  [ "$output" = "$(expected_list)" ] || fail "${FUNCNAME[0]}" "got $(printf '%s' "$output" | tr '\n' ' ')"
}

defaults_the_base_to_origin_trunk() {
  local output status=0
  in_repo git update-ref refs/remotes/origin/trunk feature
  output=$(audit) || status=$?
  in_repo git update-ref refs/remotes/origin/trunk trunk
  [ "$status" -eq 0 ] && [ -z "$output" ] || fail "${FUNCNAME[0]}" "exit $status with origin/trunk at HEAD: $output"
}

exits_zero_when_it_prints_nothing() {
  local output status=0
  output=$(audit HEAD) || status=$?
  [ "$status" -eq 0 ] && [ -z "$output" ] || fail "${FUNCNAME[0]}" "exit $status: $output"
}

diffs_from_the_merge_base_so_later_base_commits_never_print() {
  local output
  output=$(audit later) || fail "${FUNCNAME[0]}" "exit $?" || return 1
  [ "$output" = "$(expected_list)" ] || fail "${FUNCNAME[0]}" "got $(printf '%s' "$output" | tr '\n' ' ')"
}

refuses_bad_arguments_with_64_and_prints_nothing() {
  local arguments status output words
  for arguments in "trunk later" "--help" "-x"; do
    status=0
    read -r -a words <<<"$arguments"
    output=$(audit "${words[@]}" 2>/dev/null) || status=$?
    [ "$status" -eq 64 ] && [ -z "$output" ] || fail "${FUNCNAME[0]}" "exit $status on '$arguments': $output" || return 1
  done
  status=0
  output=$(audit '' 2>/dev/null) || status=$?
  [ "$status" -eq 64 ] && [ -z "$output" ] || fail "${FUNCNAME[0]}" "exit $status on an empty base: $output"
}

run() {
  if "$1"; then
    echo "ok   $1"
  else
    failures=$((failures + 1))
  fi
}

build_the_fixture_repo
run lists_an_added_if
run lists_an_added_when
run lists_each_added_condition_arm_of_a_kotlin_when
run lists_each_added_is_arm_of_a_kotlin_when
