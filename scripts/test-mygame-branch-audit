prints_a_non_ascii_path_unquoted() {
  expect_listed "${FUNCNAME[0]}" "$non_ascii:1"
}

audit_with_config() {
  local key=$1 value=$2 output status=0
  in_repo git config "$key" "$value"
  output=$(audit) || status=$?
  in_repo git config --unset "$key"
  printf '%s\n' "$output"
  return "$status"
}

expect_the_list_with_config() {
  local test=$1 output
  output=$(audit_with_config "$2" "$3") || fail "$test" "exit $?" || return 1
  [ "$output" = "$(expected_list)" ] || fail "$test" "with $2=$3 got $(printf '%s' "$output" | tr '\n' ' ')"
}

keeps_an_unchanged_rename_out_when_diff_renames_is_off() {
  expect_the_list_with_config "${FUNCNAME[0]}" diff.renames false
}

keeps_the_paths_when_diff_noprefix_is_on() {
  expect_the_list_with_config "${FUNCNAME[0]}" diff.noprefix true
}

keeps_the_list_when_color_diff_is_always() {
  expect_the_list_with_config "${FUNCNAME[0]}" color.diff always
}

keeps_the_list_when_an_external_diff_is_configured() {
  printf '#!/bin/sh\nexit 0\n' >"$sandbox/external-diff"
  chmod +x "$sandbox/external-diff"
  expect_the_list_with_config "${FUNCNAME[0]}" diff.external "$sandbox/external-diff"
}

keeps_the_list_when_a_textconv_rewrites_the_sources() {
  local attributes="$repo/.git/info/attributes" status=0
  mkdir -p "$(dirname "$attributes")"
  printf '*.ts diff=shout\n*.kt diff=shout\n' >"$attributes"
  printf '%s\n' '#!/bin/sh' "tr a-z A-Z <\"\$1\"" >"$sandbox/shout"
  chmod +x "$sandbox/shout"
  expect_the_list_with_config "${FUNCNAME[0]}" diff.shout.textconv "$sandbox/shout" || status=$?
  rm "$attributes"
  return "$status"
}

