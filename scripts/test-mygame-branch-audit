#!/usr/bin/env bash
set -euo pipefail

scripts_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

command -v rg >/dev/null || { echo "refusing to run: rg is not installed, and every negated rg check would pass" >&2; exit 70; }

while IFS= read -r variable; do
  unset "$variable"
done < <(compgen -e | awk '/^GIT_/')
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.invalid
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.invalid

temp_base=${TMPDIR:-/tmp}
sandbox=$(mktemp -d "${temp_base%/}/branch-audit-test.XXXXXX") || { echo "refusing the sandbox: mktemp -d failed" >&2; exit 70; }
[ -n "$sandbox" ] && [ -d "$sandbox" ] || { echo "refusing the sandbox: mktemp -d printed no directory" >&2; exit 70; }
sandbox=$(cd "$sandbox" && pwd -P)
case $sandbox in
  "$(cd "$temp_base" && pwd -P)"/?*) ;;
  *) echo "refusing the sandbox: $sandbox is not under $temp_base" >&2; exit 70 ;;
esac
trap 'rm -rf "$sandbox"' EXIT
export GIT_CEILING_DIRECTORIES="$sandbox"

failures=0
repo="$sandbox/myGame"
kotlin=apps/android/feature/town/src/main/kotlin/Town.kt
typescript=apps/web/src/town/branches.ts
tsx=apps/web/src/town/Badge.tsx
non_ascii=apps/web/src/town/café.ts
renamed=apps/web/src/town/renamed.ts

write() {
  mkdir -p "$repo/$(dirname "$1")"
  awk 1 >"$repo/$1"
}

in_repo() {
  (cd "$repo" && "$@")
}

build_the_fixture_repo() {
  mkdir -p "$repo"
  in_repo git init -q -b trunk
  write "$kotlin" <<'KOTLIN'
package town

fun kept(flag: Boolean): Int {
    if (flag) return 1
    return 0
}

fun removed(flag: Boolean): Boolean {
    if (flag) return true
    return false
}

fun shade(level: Int): Int = when (level) {
    0 -> 0
    else -> 1
}
KOTLIN
  write "$typescript" <<'TYPESCRIPT'
export function kept(flag: boolean): number {
  if (flag) {
    return 1;
  }
  return 0;
}
TYPESCRIPT
  write apps/web/src/town/moved.ts <<'MOVED'
if (moved) { start() }
MOVED
  in_repo git add -A
  in_repo git commit -q -m base
  in_repo git update-ref refs/remotes/origin/trunk HEAD
  in_repo git switch -q -c feature

  write "$kotlin" <<'KOTLIN'
package town

fun kept(flag: Boolean): Int {
    if (flag) return 1
    return 2
}

fun removed(flag: Boolean): Boolean {
    return flag
}

fun branches(level: Int, name: String?): Int {
    if (level > 3) return 3
    val size = when (level) {
        0 -> 1
        else -> 2
    }
    val label = name ?: "none"
    val top = maxOf(level, size)
    val low = minOf(level, size)
    val clamped = level.coerceIn(0, 9)
    val floor = level.coerceAtLeast(1)
    whenever(label)
    val length = name?.length
    val diff = top - low
    if (level > 0) return maxOf(clamped, floor)
    return floor
}

fun inlineDefault(step: Int = 1): Int = step

fun sum(left: Int, right: Int): Int = left + right

fun named(): Int = inlineDefault(step = 2)

fun multiLine(
    first: Int,
    onDone: () -> Unit = {},
) = onDone()

class Box(private val size: Int = 1)
class Tagged(@Suppress("unused") val size: Int = 1)

class Card(
    val name: String = "",
)

fun arms(level: Int, shape: Any): Int {
    val size = when {
        level > 3 -> 3
        shape is String -> 2
        else -> 1
    }
    return when (shape) {
        is Int -> shape
        else -> size
    }
}

fun shade(level: Int): Int = when (level) {
    0 -> 0
    1 -> 5
    else -> 1
}

fun labels(words: List<String>, onPick: (String) -> Unit, content: @Composable RowScope.() -> Unit): Unit {
    words.forEach { word -> onPick(word) }
    words.forEach { line: MyGameLabel ->
        onPick(line.text)
    }
    val pick: ((String) -> Unit)? = null
}

fun guards(level: Int, name: String?, shapes: List<Any>): List<Any> {
    val high = level.takeIf { it > 3 }
    val low = level.takeUnless { it > 3 }
    val kept = shapes.filter { it != high }
    val dropped = shapes.filterNot { it == low }
    name?.let { println(it) }
    val strings = shapes.filterIsInstance<String>()
    val letter = name?.letter
    return kept + dropped + strings
}

fun handlers(shapes: List<Any>): Unit {
    val loads: List<suspend () -> Unit> = emptyList()
    val handlers: Map<String, (Int) -> Unit> = emptyMap()
    val words = shapes.refilter().retakeIf().retakeUnless().refilterNot().takeIfAny().takeUnlessAll().filterNotNull()
    val draw: @Composable RowScope.() -> Unit = {}
}
KOTLIN
  write "$typescript" <<'TYPESCRIPT'
export function kept(flag: boolean): number {
  if (flag) {
    return 2;
  }
  return 0;
}

type Label = { name?: string };

export function branches(level: number, label: Label): string {
  if (level > 3) {
    return "high";
  }
  const size = level > 1 ? "big" : "small";
  const name = label.name ?? "none";
  const first = label.name?.at(0);
  const same = check(level === 2, { at: level >= 1 });
  return `${size}${name}${first}${same}`;
}

export function untyped(step = 1): number {
  return step;
}

export function typed(step: number = 1, done: () => void = () => {}): number {
  done();
  return step;
}

export function multiLine(
  first: number,
  second: number = 2,
): number {
  return first + second;
}

export const clamp = (value: number): number => (value >= 0 ? value : 0);

export function withCallback(done: () => void = noop): void {
  done();
}

export class Counter {
  constructor(private readonly start: number = 0) {}
}

export function withOptions(options: { loud: boolean } = { loud: false }): boolean {
  const { data: town } = useQuery(options);
  return town;
}

export const double = (value: number): number => value * 2;
export const named = (words: string[]): string[] => words.filter((word) => word.length > 0);
TYPESCRIPT
  write "$non_ascii" <<'NON_ASCII'
if (open) { start() }
NON_ASCII
  in_repo git mv apps/web/src/town/moved.ts "$renamed"
  write "$tsx" <<'TSX'
export function Badge({ big }: { big: boolean }): JSX.Element {
  return big ? (
    <strong>big</strong>
  ) : (
    <span>small</span>
  );
}

export function Tag({ size = 2 }: { size?: number }): JSX.Element {
  return <span>{size}</span>;
}

export const tone = (big: boolean): string => (big ? "loud" : "soft");
TSX
  local excluded
  for excluded in \
    apps/web/src/town/branches.test.ts \
    apps/web/src/town/Badge.test.tsx \
    apps/web/src/town/fixtures.testSupport.ts \
    apps/android/feature/town/src/test/kotlin/TownTest.kt \
    apps/android/feature/town/src/androidTest/kotlin/TownUiTest.kt \
    apps/android/core/testing/src/main/kotlin/FakeClock.kt \
    packages/domain/src/testing/fakeClock.ts \
    apps/web/src/legacy.js \
    docs/notes.md; do
    write "$excluded" <<'EXCLUDED'
if (ready) { start() }
val size = when (level) { else -> 1 }
val top = maxOf(level, 1)
val low = minOf(level, 1)
val clamped = level.coerceIn(0, 9)
val label = name ?: "none"
const fallback = label.name ?? "none";
const tone = big ? "loud" : "soft";
fun inlineDefault(step: Int = 1): Int = step
export function untyped(step = 1): number { return step; }
    first: Int = 1,
EXCLUDED
  done
  in_repo git add -A
  in_repo git commit -q -m feature

  in_repo git switch -q -c later trunk
  write "$kotlin" <<'KOTLIN'
package town

fun kept(flag: Boolean): Int {
    return 0
}

fun removed(flag: Boolean): Boolean {
    if (flag) return true
    return false
}
KOTLIN
  write apps/web/src/late.ts <<'LATE'
if (late) { start() }
LATE
  in_repo git add -A
  in_repo git commit -q -m later
  in_repo git switch -q feature
}

audit() {
  in_repo /usr/bin/timeout -k 1 20 "$scripts_dir/mygame-branch-audit" "$@"
}

fail() {
  printf 'FAIL %s: %s\n' "$1" "$2" >&2
  return 1
}

expect_listed() {
  local test=$1 output entry
  shift
  output=$(audit) || fail "$test" "exit $?" || return 1
  for entry in "$@"; do
    printf '%s\n' "$output" | rg -qxF -- "$entry" || fail "$test" "$entry is not listed" || return 1
  done
}

expect_not_listed() {
  local test=$1 output entry
  shift
  output=$(audit) || fail "$test" "exit $?" || return 1
  for entry in "$@"; do
    ! printf '%s\n' "$output" | rg -qxF -- "$entry" || fail "$test" "$entry is listed" || return 1
  done
}

expect_nothing_listed_under() {
  local test=$1 prefix=$2 output
  output=$(audit) || fail "$test" "exit $?" || return 1
  ! printf '%s\n' "$output" | rg -qF -- "$prefix" || fail "$test" "$(printf '%s\n' "$output" | rg -F -- "$prefix" | head -n 1) is listed"
}

lists_an_added_if() {
  expect_listed "${FUNCNAME[0]}" "$kotlin:13" "$typescript:11"
}

lists_an_added_when() {
  expect_listed "${FUNCNAME[0]}" "$kotlin:14"
}

