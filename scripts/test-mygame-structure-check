  fresh_tree
  plant apps/web/src/town/TownScreen.tsx "import { inMemoryTowns } from '@mygame/domain/testing'\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check production_imports_fakes apps/web/src/town/TownScreen.tsx 1:import"
}

passes_the_fakes_in_tests_contract_suites_and_the_testing_entry() {
  local exports="export const a = 1\nexport const b = 2\nexport const c = 3\nexport const d = 4\nexport const e = 5\nexport { inMemoryTowns } from '#town/testing/inMemoryTowns'\n"
  fresh_tree
  plant apps/api/src/town/infrastructure/memory/inMemoryTowns.test.ts "import { inMemoryTowns } from '@mygame/domain/testing'\n"
  plant apps/api/src/town/infrastructure/memory/townRepositoryContract.testSupport.ts "import { inMemoryTowns } from '@mygame/domain/testing'\n"
  plant packages/domain/src/town/useCases/sendJob.test.ts "import { inMemoryTowns } from '../testing/inMemoryTowns'\n"
  plant packages/domain/src/town/testing/inMemoryTowns.ts "import { inMemoryEarnedSkills } from './inMemoryEarnedSkills'\n"
  plant packages/domain/src/testing.ts "$exports"
  plant apps/web/src/town/TownScreen.test.tsx "import { inMemoryTowns } from '@mygame/domain/testing'\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

