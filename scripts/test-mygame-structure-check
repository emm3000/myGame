  fresh_tree
  plant packages/domain/src/town/SixExports.ts "export const a = 1\nexport const b = 2\nexport const c = 3\nexport const d = 4\nexport const e = 5\nexport const f = 6\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check file_over_export_cap packages/domain/src/town/SixExports.ts 6 exports"
}

passes_tables_and_entries_over_five_exports() {
  local exports="export const a = 1\nexport const b = 2\nexport const c = 3\nexport const d = 4\nexport const e = 5\nexport const f = 6\n"
  fresh_tree
  plant apps/api/src/town/infrastructure/postgres/townTables.ts "$exports"
  plant packages/contracts/src/index.ts "$exports"
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_an_interface_over_seven_methods() {
  fresh_tree
  plant apps/api/src/account/application/ports/Accounts.ts "export interface Accounts {\n  a(): void\n  b(): void\n  c(): void\n  d(): void\n  e(): void\n  f(): void\n  g(): void\n  h(): void\n}\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check type_over_method_cap apps/api/src/account/application/ports/Accounts.ts 8 methods in export interface Accounts {"
}

passes_a_class_of_seven_methods_and_its_accessors() {
  fresh_tree
  plant packages/domain/src/town/Town.ts "export class Town {\n  constructor(private readonly id: string) {}\n  get name(): string {\n    return this.id\n  }\n  a(): void {}\n  b(): void {}\n  c(): void {}\n  d(): void {}\n  e(): void {}\n  f(): void {}\n  private g(): void {}\n}\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_a_map_that_misses_a_folder() {
  fresh_tree
  plant ARCHITECTURE.md "| Feature | What |\n|---|---|\n| \`platform\` | the kernel |\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check map: the folders under apps/api/src and packages/domain/src and the rows of ARCHITECTURE.md differ"
}

fails_a_map_with_a_row_for_no_folder() {
  fresh_tree
  plant ARCHITECTURE.md "| Feature | What |\n|---|---|\n| \`routes\` | the old routes |\n| \`town\` | the holding |\n"
  check
  expect_failure "${FUNCNAME[0]}" "> routes"
}

fails_without_a_map() {
  fresh_tree
  rm "$tree/ARCHITECTURE.md"
  check
  expect_failure "${FUNCNAME[0]}" "structure check map: ARCHITECTURE.md could not be read"
}

passes_a_map_that_matches_the_folders() {
  fresh_tree
  plant ARCHITECTURE.md "| Feature | What |\n|---|---|\n| \`town\` | the holding |\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

passes_a_baselined_violation() {
  fresh_tree
  plant packages/domain/src/town/readTown.ts "export const readTown = (): Promise<number> => Promise.resolve(1)\n"
  printf 'domain_promise_outside_its_roles packages/domain/src/town/readTown.ts\n' >"$baseline"
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_a_baseline_line_that_no_longer_fails() {
  fresh_tree
  printf 'folder_over_limit packages/domain/src/town\n' >"$baseline"
  check
  expect_failure "${FUNCNAME[0]}" "structure baseline folder_over_limit: packages/domain/src/town no longer fails; delete its line"
}

fails_a_baseline_line_that_names_no_check() {
  fresh_tree
  printf 'oversized packages/domain/src/town\n' >"$baseline"
  check
  expect_failure "${FUNCNAME[0]}" "structure baseline: 'oversized packages/domain/src/town' names no check"
}

refuses_to_run_without_ripgrep() {
  local bin="$sandbox/bin-without-rg"
  fresh_tree
  mkdir -p "$bin"
  ln -sf "$(command -v bash)" "$bin/bash"
  ln -sf "$(command -v dirname)" "$bin/dirname"
  run_the_check env PATH="$bin" scripts/mygame-structure-check
  [ "$status" -eq 2 ] && [ "$err" = "structure check: rg (ripgrep) is not installed" ] || fail "${FUNCNAME[0]}" "exit $status, stderr '$err'"
}

run() {
  if "$1"; then
    echo "ok   $1"
  else
    failures=$((failures + 1))
  fi
}

run passes_a_clean_tree
run fails_an_application_importing_infrastructure
run fails_an_application_importing_infrastructure_by_subpath
run fails_an_application_knowing_the_wire
run fails_contracts_outside_their_adapters
run passes_contracts_in_http_json_and_the_gate
run fails_persistence_knowing_http
run fails_http_knowing_the_database
run fails_an_adapter_built_outside_the_composition_root
run passes_an_adapter_built_in_the_composition_root
run fails_an_async_reading_named_of
run fails_an_async_const_named_of
run fails_a_const_named_at_that_declares_a_promise
run passes_a_synchronous_const_named_of_and_an_async_one_in_a_test
run fails_a_subpath_import_inside_its_own_folder
run fails_a_domain_test_importing_its_own_folder_by_subpath
run passes_a_subpath_import_that_leaves_its_folder_or_the_root
run fails_an_api_file_importing_the_domain_fakes
run fails_a_domain_file_importing_a_fake
run fails_a_web_file_importing_the_domain_fakes
run passes_the_fakes_in_tests_contract_suites_and_the_testing_entry
run fails_a_use_case_named_of
run fails_a_domain_promise_outside_its_roles
run passes_a_domain_promise_in_a_port
run fails_a_use_case_importing_a_use_case_from_its_folder
run fails_a_use_case_importing_another_features_use_case
run fails_a_use_case_importing_another_features_use_case_by_subpath
run fails_a_public_service
run fails_a_folder_over_thirty_production_files
run passes_a_folder_of_thirty_production_files_and_its_tests
run fails_a_file_over_five_exports
run passes_tables_and_entries_over_five_exports
run fails_an_interface_over_seven_methods
run passes_a_class_of_seven_methods_and_its_accessors
run fails_a_map_that_misses_a_folder
run fails_a_map_with_a_row_for_no_folder
run fails_without_a_map
run passes_a_map_that_matches_the_folders
run passes_a_baselined_violation
run fails_a_baseline_line_that_no_longer_fails
run fails_a_baseline_line_that_names_no_check
run refuses_to_run_without_ripgrep
[ "$failures" -eq 0 ]
