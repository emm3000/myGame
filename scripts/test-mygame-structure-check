use_case() {
  plant packages/domain/src/town/jobs/application/SendJob.ts "export type SendJobDependencies = { readonly clock: Clock }\n\nexport class SendJob {\n  constructor(private readonly dependencies: SendJobDependencies) {}\n\n  async execute(command: SendJobCommand): Promise<Result<TownReading, DomainError>> {\n    return dispatchJob(command, this.dependencies)\n  }\n}\n"
}

controller() {
  plant apps/api/src/town/jobs/infrastructure/http/SendJobController.ts "export class SendJobController {\n  constructor(private readonly dependencies: SendJobControllerDependencies) {}\n\n  async handle(c: Context<SignedInPlayer>): Promise<Response> {\n    return this.respond(c)\n  }\n\n  private respond(c: Context<SignedInPlayer>): Response {\n    return c.json({})\n  }\n}\n"
}

passes_a_use_case_its_controller_and_their_builders() {
  fresh_tree
  use_case
  controller
  plant apps/api/src/composeUseCases.ts "export const composeUseCases = (adapters: UseCaseDependencies): UseCases => ({\n  sendJob: new SendJob(adapters),\n})\n"
  plant apps/api/src/town/jobs/infrastructure/http/jobsRoutes.ts "export const jobsRoutes = (routes: OpenAPIHono, dependencies: JobsRouteDependencies): void => {\n  const sendJobController = new SendJobController(dependencies)\n}\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_a_use_case_that_is_a_function() {
  fresh_tree
  plant packages/domain/src/town/jobs/application/SendJob.ts "export const SendJob = async (command: SendJobCommand): Promise<number> => 1\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check use_case_shape packages/domain/src/town/jobs/application/SendJob.ts is not one exported class with a constructor and one async execute("
}

fails_a_use_case_with_a_second_method() {
  fresh_tree
  plant packages/domain/src/town/jobs/application/SendJob.ts "export class SendJob {\n  constructor(private readonly dependencies: SendJobDependencies) {}\n\n  async execute(command: SendJobCommand): Promise<number> {\n    return this.dispatch(command)\n  }\n\n  private dispatch(command: SendJobCommand): number {\n    return 1\n  }\n}\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check use_case_shape packages/domain/src/town/jobs/application/SendJob.ts a second method:   private dispatch(command: SendJobCommand): number {"
}

fails_a_controller_without_handle() {
  fresh_tree
  plant apps/api/src/town/jobs/infrastructure/http/SendJobController.ts "export class SendJobController {\n  constructor(private readonly dependencies: SendJobControllerDependencies) {}\n\n  async run(c: Context<SignedInPlayer>): Promise<Response> {\n    return c.json({})\n  }\n}\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check controller_shape apps/api/src/town/jobs/infrastructure/http/SendJobController.ts a second method:   async run(" &&
    expect_failure "${FUNCNAME[0]}" "structure check controller_shape apps/api/src/town/jobs/infrastructure/http/SendJobController.ts is not one exported class with a constructor and one async handle("
}

