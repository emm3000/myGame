  fresh_tree
  plant packages/domain/src/town/useCases/sendJob.ts "const askedJobOf = async (id: string): Promise<string> => id\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check reading_const_is_async packages/domain/src/town/useCases/sendJob.ts 1:const askedJobOf"
}

fails_a_const_named_at_that_declares_a_promise() {
  fresh_tree
  plant apps/api/src/town/application/serveReport.ts "export const serveReport = (): number => 1\n\nexport const shownAt = (\n  playerId: string,\n  read: (at: number) => number,\n): Promise<number> => Promise.resolve(read(1))\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check reading_const_is_async apps/api/src/town/application/serveReport.ts 3:const shownAt"
}

passes_a_synchronous_const_named_of_and_an_async_one_in_a_test() {
  fresh_tree
  plant packages/domain/src/town/jobSiteOf.ts "export const jobSiteOf = (id: string): string => id\nexport const jobDueAt = (pay: (hours: number) => number): number => pay(1)\n"
  plant apps/api/src/town/infrastructure/http/townRoutes.testSupport.ts "export const overviewOf = async (response: Response): Promise<unknown> => response.json()\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

