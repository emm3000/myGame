  fresh_tree
  plant apps/api/src/town/jobs/infrastructure/http/sendJobRoute.ts "import { mutateTown } from '#town/application/mutateTown'\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check subpath_import_inside_folder apps/api/src/town/jobs/infrastructure/http/sendJobRoute.ts 1:import { mutateTown } from '#town/application/mutateTown'"
}

fails_a_domain_test_importing_its_own_folder_by_subpath() {
  fresh_tree
  plant packages/domain/src/town/jobPayOf.test.ts "const loaded = import('#town/jobPayOf')\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check subpath_import_inside_folder packages/domain/src/town/jobPayOf.test.ts 1:const loaded"
}

passes_a_subpath_import_that_leaves_its_folder_or_the_root() {
  fresh_tree
  plant apps/api/src/town/infrastructure/http/townRoutes.ts "import { refusal } from '#platform/application/Refusal'\nimport { townRoutesBy } from '#townRoutes/byName'\n"
  plant apps/api/src/composeServer.ts "import { townRoutes } from '#town/infrastructure/http/townRoutes'\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

