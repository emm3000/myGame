  fresh_tree
  files_in packages/contracts/src/town 31
  check
  expect_failure "${FUNCNAME[0]}" "structure check folder_over_limit packages/contracts/src/town 31 production files"
}

passes_a_folder_of_thirty_production_files_and_its_tests() {
  fresh_tree
  files_in packages/contracts/src/town 30
  plant packages/contracts/src/town/Schema1.test.ts "export const test = 1\n"
  plant packages/contracts/src/town/schema.testSupport.ts "export const support = 1\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

