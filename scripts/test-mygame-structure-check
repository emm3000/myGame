  fresh_tree
  plant apps/api/src/town/application/sendJob.ts "export const towns = new DrizzleTownRepository(database)\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check adapter_built_outside_root apps/api/src/town/application/sendJob.ts 1:export"
}

passes_an_adapter_built_in_the_composition_root() {
  fresh_tree
  plant apps/api/src/composeStores.ts "export const towns = new DrizzleTownRepository(database)\n"
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_an_async_reading_named_of() {
  fresh_tree
  plant apps/api/src/town/application/currentTownOf.ts "export async function currentTownOf(): Promise<number> {\n  return 1\n}\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check reading_named_of_is_async apps/api/src/town/application/currentTownOf.ts"
}

