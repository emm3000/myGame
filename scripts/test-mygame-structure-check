#!/usr/bin/env bash
set -euo pipefail

scripts_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

temp_base=${TMPDIR:-/tmp}
sandbox=$(mktemp -d "${temp_base%/}/structure-check-test.XXXXXX") || { echo "refusing the sandbox: mktemp -d failed" >&2; exit 70; }
[ -n "$sandbox" ] && [ -d "$sandbox" ] || { echo "refusing the sandbox: mktemp -d printed no directory" >&2; exit 70; }
sandbox=$(cd "$sandbox" && pwd -P)
case $sandbox in
  "$(cd "$temp_base" && pwd -P)"/?*) ;;
  *) echo "refusing the sandbox: $sandbox is not under $temp_base" >&2; exit 70 ;;
esac
trap 'rm -rf "$sandbox"' EXIT

failures=0
status=0
err=""
tree="$sandbox/tree"
baseline="$tree/scripts/mygame-structure-check.baseline"

fresh_tree() {
  rm -rf "$tree"
  mkdir -p "$tree/scripts" "$tree/apps/api/src/town" "$tree/packages/domain/src/town" "$tree/packages/contracts/src"
  cp "$scripts_dir/mygame-structure-check" "$tree/scripts/"
  : >"$baseline"
  printf "export const port = 3000\n" >"$tree/apps/api/src/listen.ts"
  plant packages/domain/src/town/domain/jobPayOf.ts "export const jobPayOf = (hours: number): number => hours * 2\n"
  printf "export { jobPayOf } from './town/domain/jobPayOf'\n" >"$tree/packages/domain/src/index.ts"
  printf "export const SendJob = 'send-job'\n" >"$tree/packages/contracts/src/SendJob.ts"
  plant ARCHITECTURE.md "| Folder | What |\n|---|---|\n| \`town\` | the holding |\n"
}

plant() {
  mkdir -p "$(dirname "$tree/$1")"
  printf '%b' "$2" >"$tree/$1"
}

run_the_check() {
  status=0
  (cd "$tree" && /usr/bin/timeout -k 1 20 "$@") >"$sandbox/stdout" 2>"$sandbox/stderr" || status=$?
  err=$(<"$sandbox/stderr")
}

check() {
  run_the_check scripts/mygame-structure-check
}

fail() {
  printf 'FAIL %s: %s\n' "$1" "$2" >&2
  return 1
}

expect_pass() {
  [ "$status" -eq 0 ] && [ -z "$err" ] || fail "$1" "exit $status, stderr '$err'"
}

expect_failure() {
  local test=$1 line=$2
  [ "$status" -eq 1 ] || fail "$test" "exit $status, stderr '$err'" || return 1
  printf '%s\n' "$err" | rg --no-config -qF -- "$line" || fail "$test" "'$line' is not on stderr: '$err'"
}

files_in() {
  local folder=$1 count=$2 index
  for index in $(seq 1 "$count"); do
    plant "$folder/Schema$index.ts" "export const Schema$index = $index\n"
  done
}

passes_a_clean_tree() {
  fresh_tree
  check
  expect_pass "${FUNCNAME[0]}"
}

fails_an_application_importing_infrastructure() {
  fresh_tree
  plant apps/api/src/town/application/sendJob.ts "import { DrizzleTownRepository } from '../infrastructure/persistence/DrizzleTownRepository'\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check application_imports_infrastructure apps/api/src/town/application/sendJob.ts 1:import"
}

