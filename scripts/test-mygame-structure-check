  fresh_tree
  plant packages/domain/src/town/useCases/sendJob.ts "import { inMemoryTowns } from '../testing/inMemoryTowns'\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check production_imports_fakes packages/domain/src/town/useCases/sendJob.ts 1:import"
