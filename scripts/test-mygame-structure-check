  fresh_tree
  plant packages/domain/src/index.ts "export { resolveStoredTown } from './town/services/resolveStoredTown'\n"
  check
  expect_failure "${FUNCNAME[0]}" "structure check service_is_public packages/domain/src/index.ts 1:export"
}

